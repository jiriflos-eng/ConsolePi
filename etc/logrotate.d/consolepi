/var/log/consolepi/transcripts/*.log {
    daily
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    dateext
    su console console
    create 0600 console console
}

/var/log/consolepi/ports.log {
    daily
    rotate 14
    size 1M
    maxage 30
    missingok
    notifempty
    compress
    delaycompress
    su root adm
    create 0640 root adm
}
