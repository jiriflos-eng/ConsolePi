#!/usr/bin/python3
"""Import only one Ed25519 key from an exact Imager 2.0.10 key-only payload."""
import os
import pwd
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, "/usr/local/lib")
from consolepi_imager_security import ImagerImportError, cleanup_imager_payload, import_key_only_customization, mark_failure


def password_locked(user):
    result = subprocess.run(["passwd", "-S", user], text=True, capture_output=True, check=False)
    return result.returncode == 0 and len(result.stdout.split()) > 1 and result.stdout.split()[1] in {"L", "LK"}


def main():
    if os.geteuid() != 0:
        raise SystemExit(1)
    if len(sys.argv) == 3 and sys.argv[1] == "--mark-failure":
        mark_failure(reason=sys.argv[2])
        raise SystemExit(1)
    if len(sys.argv) != 2: raise SystemExit(1)
    boot = Path(sys.argv[1])
    try:
        account = pwd.getpwnam("consolepi")
        if account.pw_uid != 1000 or account.pw_dir != "/home/consolepi" or not password_locked("consolepi"):
            raise ImagerImportError("consolepi account is not the expected locked UID 1000 account")
        import_key_only_customization(boot, account.pw_dir, account.pw_uid, account.pw_gid)
    except Exception as exc:
        try: mark_failure(reason=str(exc))
        except Exception: pass
        try: cleanup_imager_payload(boot)
        except Exception: pass
        print(f"ConsolePi Imager import rejected: {exc}", file=sys.stderr)
        raise SystemExit(1)


if __name__ == "__main__": main()
