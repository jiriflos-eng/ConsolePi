#!/usr/bin/python3
"""Interaktivní nouzová obnova hesla webové administrace."""
import getpass
import os
import subprocess
import sys

from werkzeug.security import generate_password_hash


def main():
    if os.geteuid() != 0:
        print(
            "Spusťte příkaz pomocí: sudo consolepi-reset-web-password",
            file=sys.stderr,
        )
        return 1
    if not sys.stdin.isatty():
        print("Obnova hesla vyžaduje interaktivní terminál.", file=sys.stderr)
        return 1

    first = getpass.getpass("Nové webové heslo: ")
    second = getpass.getpass("Nové heslo znovu: ")
    if first != second:
        print("Hesla se neshodují.", file=sys.stderr)
        return 1
    if not 10 <= len(first) <= 128:
        print("Heslo musí mít 10 až 128 znaků.", file=sys.stderr)
        return 1

    result = subprocess.run(
        ["/usr/local/sbin/consolepi-control", "web-password", "set"],
        input=generate_password_hash(first),
        text=True,
        check=False,
    )
    if result.returncode:
        return result.returncode
    print("Heslo webové administrace bylo změněno.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
