#!/bin/sh
# Sanitise an installed ConsolePi immediately before capturing a generic image.
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
LC_ALL=C
export LC_ALL
umask 077

STATE_DIR=/etc/consolepi
RECOVERY=$STATE_DIR/generic-image-recovery.txt
IMAGER_GUARD=/usr/local/libexec/consolepi-imager-guard
IMAGER_CUSTOM_GUARD=/usr/local/libexec/consolepi-imager-custom-guard
IMAGER_USER_GUARD=/usr/local/libexec/consolepi-imager-userconf-guard
IMAGER_POSTVALIDATE=/usr/local/libexec/consolepi-imager-postvalidate
VENDOR_CUSTOM=/usr/lib/raspberrypi-sys-mods/imager_custom
VENDOR_USERCONF=/usr/lib/userconf-pi/userconf
destructive=no
prep_dir=
boot_mount=
poweroff_after_validation=no
detached_run=no

usage()
{
    cat <<'EOF'
Použití: sudo consolepi-prepare-generic-image [--poweroff]

Bez volby provede sanitizaci a validaci, ale zařízení nevypne.
--poweroff po potvrzení předá destruktivní běh samostatné systemd úloze a
vypne zařízení pouze po úplném úspěchu post-sanitizační validace.
EOF
}

case "${1:-}" in
    '') ;;
    --poweroff) poweroff_after_validation=yes ;;
    --poweroff-internal) poweroff_after_validation=yes; detached_run=yes ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac
[ "$#" -le 1 ] || { usage >&2; exit 2; }

cleanup()
{
    status=$?
    trap - EXIT HUP INT TERM
    [ -z "$prep_dir" ] || rm -rf "$prep_dir"
    if [ "$status" -ne 0 ] && [ "$destructive" = yes ]; then
        printf '\nSANITIZACE SELHALA. Zařízení ponechte odpojené od sítě.\n' >&2
        printf 'Z lokální konzole opravte uvedenou chybu a spusťte tento příkaz znovu.\n' >&2
        printf 'Podrobný postup obnovy: %s\n' "$RECOVERY" >&2
    fi
    exit "$status"
}
trap cleanup EXIT HUP INT TERM

fail()
{
    printf 'Preflight generic image: %s\n' "$*" >&2
    if [ "$destructive" = yes ] && [ -x /usr/local/sbin/consolepi-validate-generic-image ]; then
        /usr/local/sbin/consolepi-validate-generic-image >/dev/null 2>&1 || true
    fi
    exit 1
}

[ "$(id -u)" -eq 0 ] || fail 'spusťte jako root (sudo)'
[ "$(id -u consolepi 2>/dev/null)" = 1000 ] || fail 'účet consolepi musí mít UID 1000'
id console >/dev/null 2>&1 || fail 'chybí účet console'
getent group consolepi-web >/dev/null 2>&1 || fail 'chybí skupina consolepi-web'
[ -x /usr/local/sbin/consolepi-generic-image-firstboot ] || fail 'chybí first-boot program'
[ -x /usr/local/sbin/consolepi-validate-generic-image ] || fail 'chybí post-sanitizační validátor'
[ -f /etc/systemd/system/consolepi-generic-image-firstboot.service ] || fail 'chybí first-boot unit'
[ -x /usr/local/sbin/consolepi-generic-recovery ] || fail 'chybí physical-console recovery program'
[ -f /usr/local/lib/consolepi_generic_recovery.py ] || fail 'chybí physical-console recovery modul'
[ -f /etc/systemd/system/consolepi-generic-recovery.service ] || fail 'chybí physical-console recovery unit'
[ -x /bin/bash ] || fail 'chybí /bin/bash pro physical-console recovery'
for program in "$IMAGER_GUARD" "$IMAGER_CUSTOM_GUARD" "$IMAGER_USER_GUARD" "$IMAGER_POSTVALIDATE"; do
    [ -x "$program" ] || fail "chybí generic Imager guard $program"
    [ -f "$program" ] && [ ! -L "$program" ] || fail "Imager guard není bezpečný soubor: $program"
    [ "$(stat -c '%u:%g:%h' "$program")" = 0:0:1 ] || fail "Imager guard nemá bezpečná metadata: $program"
    mode=$(stat -c '%a' "$program")
    [ $((0$mode & 0022)) -eq 0 ] || fail "Imager guard je zapisovatelný mimo root: $program"
done
[ -f "$VENDOR_CUSTOM" ] && [ ! -L "$VENDOR_CUSTOM" ] || fail 'vendor imager_custom chybí nebo není bezpečný soubor'
[ -f "$VENDOR_USERCONF" ] && [ ! -L "$VENDOR_USERCONF" ] || fail 'vendor userconf chybí nebo není bezpečný soubor'
[ "$(stat -c '%u:%g' "$VENDOR_CUSTOM")" = 0:0 ] || fail 'vendor imager_custom není root:root'
[ "$(stat -c '%u:%g' "$VENDOR_USERCONF")" = 0:0 ] || fail 'vendor userconf není root:root'
[ "$(stat -c '%h' "$VENDOR_CUSTOM")" = 1 ] || fail 'vendor imager_custom má neočekávaný hardlink'
[ "$(stat -c '%h' "$VENDOR_USERCONF")" = 1 ] || fail 'vendor userconf má neočekávaný hardlink'
for program in "$VENDOR_CUSTOM" "$VENDOR_USERCONF"; do
    mode=$(stat -c '%a' "$program")
    [ $((0$mode & 0022)) -eq 0 ] || fail "vendor Imager entrypoint je zapisovatelný mimo root: $program"
done
[ ! -e "$VENDOR_CUSTOM.consolepi-vendor" ] && [ ! -L "$VENDOR_CUSTOM.consolepi-vendor" ] || fail 'vendor imager_custom backup už existuje'
[ ! -e "$VENDOR_USERCONF.consolepi-vendor" ] && [ ! -L "$VENDOR_USERCONF.consolepi-vendor" ] || fail 'vendor userconf backup už existuje'
[ -f /usr/local/lib/consolepi_imager_security.py ] || fail 'chybí Imager security modul'
[ -w /etc ] && [ -w "$STATE_DIR" ] && [ -w /home/consolepi ] || fail 'potřebné filesystémy nejsou zapisovatelné'
[ "$(df -Pk "$STATE_DIR" | awk 'NR==2 {print $4}')" -ge 10240 ] || fail 'je potřeba alespoň 10 MiB volného místa'
for command in awk cat cp df find findmnt getent grep hostnamectl install journalctl ln mktemp mount mountpoint mv nft openssl passwd python3 readlink sshd ssh-keygen stat sync systemctl systemd-analyze systemd-run truncate tty; do
    command -v "$command" >/dev/null 2>&1 || fail "chybí utilita $command"
done

# Locate the mounted Raspberry Pi firmware FAT partition by content and type.
boot_candidates=
while IFS=' ' read -r target fstype; do
    case "$fstype" in vfat|msdos|fat|fat32) ;; *) continue ;; esac
    [ -f "$target/config.txt" ] && [ -f "$target/cmdline.txt" ] || continue
    boot_candidates="${boot_candidates}${target}\n"
done <<EOF
$(findmnt -rn -o TARGET,FSTYPE)
EOF
boot_mount=$(printf '%b' "$boot_candidates" | sed '/^$/d')
[ -n "$boot_mount" ] && [ "$(printf '%s\n' "$boot_mount" | wc -l | tr -d ' ')" -eq 1 ] ||
    fail 'nelze jednoznačně určit připojenou firmware FAT partition'
case "$boot_mount" in /boot/*) ;; *) fail "firmware partition má nepodporovaný mountpoint $boot_mount" ;; esac
[ -w "$boot_mount" ] || fail "firmware partition $boot_mount není zapisovatelná"
[ -d /var/lib/cloud ] && [ ! -L /var/lib/cloud ] && [ -w /var/lib/cloud ] ||
    fail '/var/lib/cloud chybí, je symlink nebo není zapisovatelný'
[ ! -e /boot/firstrun.sh ] && [ ! -L /boot/firstrun.sh ] || fail '/boot/firstrun.sh už existuje'
python3 - /boot/cmdline.txt <<'PY' || fail '/boot/cmdline.txt není bezpečný Raspberry Pi OS placeholder'
import sys
sys.path.insert(0, "/usr/local/lib")
from consolepi_imager_security import validate_legacy_cmdline
validate_legacy_cmdline(sys.argv[1])
PY
python3 - "$IMAGER_GUARD" "$IMAGER_POSTVALIDATE" <<'PY' || fail 'Imager guard není syntakticky platný'
import ast, pathlib, sys
for path in sys.argv[1:]: ast.parse(pathlib.Path(path).read_text())
PY
python3 - /usr/local/lib/consolepi_imager_security.py <<'PY' || fail 'Imager security modul není syntakticky platný'
import ast, pathlib, sys
ast.parse(pathlib.Path(sys.argv[1]).read_text())
PY
sh -n "$IMAGER_CUSTOM_GUARD" || fail 'Imager custom guard není syntakticky platný'
sh -n "$IMAGER_USER_GUARD" || fail 'Imager userconf guard není syntakticky platný'
sh -n /usr/local/sbin/consolepi-validate-generic-image || fail 'post-sanitizační validátor není syntakticky platný'

unexpected_accounts=$(python3 - <<'PY'
import sys
sys.path.insert(0, "/usr/local/lib")
from consolepi_firstboot_security import unexpected_login_accounts
print(" ".join(unexpected_login_accounts(open("/etc/passwd").read())))
PY
)
[ -z "$unexpected_accounts" ] || fail "neočekávané login-capable účty: $unexpected_accounts"

prep_dir=$(mktemp -d "$STATE_DIR/.generic-prep.XXXXXX")
cat >"$prep_dir/generic-ssh.conf" <<'EOF'
# Aktivováno pouze na sanitizované generic image.
AllowUsers consolepi console
PermitRootLogin no
Match User consolepi
    AuthenticationMethods publickey
    PubkeyAuthentication yes
    PasswordAuthentication no
    KbdInteractiveAuthentication no
Match all
EOF
cat >"$prep_dir/dependency.conf" <<'EOF'
[Unit]
Requires=consolepi-generic-image-firstboot.service
After=consolepi-generic-image-firstboot.service
EOF
cat >"$prep_dir/radius.json" <<'EOF'
{"primary_host":"","primary_port":1812,"primary_secret_set":false,"secondary_host":"","secondary_port":1812,"secondary_secret_set":false,"timeout":3,"retries":1,"accounting":false}
EOF
printf '%s\n' '{"primary":"","secondary":""}' >"$prep_dir/radius-secrets.json"
printf '%s\n' '# RADIUS není v generic image nastaven.' >"$prep_dir/pam_radius_auth.conf"
cat >"$prep_dir/snmpv3.json" <<'EOF'
{"enabled":false,"username":"","auth_protocol":"SHA-256","privacy_protocol":"AES"}
EOF
printf '%s\n' '{"auth_password":"","privacy_password":""}' >"$prep_dir/snmpv3-secrets.json"
cat >"$prep_dir/proxy.json" <<'EOF'
{"enabled":false,"scheme":"http","host":"","port":8080,"username":"","password":"","no_proxy":"localhost,127.0.0.1,::1"}
EOF
printf '%s\n' '{"sources":[]}' >"$prep_dir/access-sources.json"
printf '%s\n' '{"display_name":"ConsolePi","location":"","description":"Sériový konzolový server"}' >"$prep_dir/identity.json"
printf '%s\n' '{}' >"$prep_dir/labels.json"
printf '%s\n' 'AUTH_MODE=local_key' >"$prep_dir/auth.conf"
printf '%s\n' '{"state":"pending","reason":"generic_image"}' >"$prep_dir/generic-image.json"
printf '%s\n' '{"state":"pending","reason":"generic_image"}' >"$prep_dir/firstboot.json"
cat >"$prep_dir/wired-generic.nmconnection" <<'EOF'
[connection]
id=Wired connection 1
type=ethernet
interface-name=eth0
autoconnect=true

[ethernet]

[ipv4]
method=auto

[ipv6]
method=auto
addr-gen-mode=default
EOF
cat >"$prep_dir/recovery.txt" <<'EOF'
ConsolePi generic-image recovery (pouze z lokální konzole)
1. Zařízení nepřipojujte do sítě a zkontrolujte chybu předchozího běhu.
2. Po opravě spusťte znovu: sudo consolepi-prepare-generic-image
3. Chcete-li přípravu zrušit, obnovte vlastní veřejný klíč do
   /home/consolepi/.ssh/authorized_keys, odstraňte generic drop-in soubory
   v /etc/systemd/system/{ssh,nginx,consolepi-web}.service.d, zakažte
   consolepi-generic-image-firstboot.service, spusťte systemctl daemon-reload
   a služby povolte teprve po ověření SSH/TLS/web konfigurace.
EOF
cp "$IMAGER_CUSTOM_GUARD" "$prep_dir/imager-custom-guard"
cp "$IMAGER_USER_GUARD" "$prep_dir/imager-userconf-guard"
printf '%s\n' 'generic-image-systemd-v2' >"$prep_dir/imager-systemd-compat"
printf '%s\n' "$boot_mount" >"$prep_dir/imager-boot-mount"
printf '%s\n' uninitialized >"$prep_dir/machine-id"

# Validate complete candidate SSH and systemd configurations before deletion.
awk '$1 != "Include"' /etc/ssh/sshd_config >"$prep_dir/sshd_config"
printf 'Include %s\n' "$prep_dir/generic-ssh.conf" >>"$prep_dir/sshd_config"
printf '%s\n' 'Include /etc/ssh/sshd_config.d/*.conf' >>"$prep_dir/sshd_config"
sshd -t -f "$prep_dir/sshd_config" || fail 'kandidátní generic SSH konfigurace není platná'
for service in ssh nginx consolepi-web; do
    source_unit=/etc/systemd/system/$service.service
    [ -f "$source_unit" ] || source_unit=/lib/systemd/system/$service.service
    [ -f "$source_unit" ] || source_unit=/usr/lib/systemd/system/$service.service
    [ -f "$source_unit" ] || fail "chybí systemd unit $service.service"
    cp "$source_unit" "$prep_dir/$service.service"
    cat "$prep_dir/dependency.conf" >>"$prep_dir/$service.service"
done
systemd-analyze verify /etc/systemd/system/consolepi-generic-image-firstboot.service \
    /etc/systemd/system/consolepi-generic-recovery.service \
    "$prep_dir/ssh.service" "$prep_dir/nginx.service" "$prep_dir/consolepi-web.service" >/dev/null ||
    fail 'kandidátní generic systemd konfigurace není platná'

printf '%s\n' 'Tento krok nevratně odstraní klíče, identity a lokální tajemství z masteru.'
if [ "$detached_run" != yes ]; then
    printf '%s' 'Pro pokračování napište GENERIC: '
    IFS= read -r confirmation
    [ "$confirmation" = GENERIC ] || { printf '%s\n' 'Zrušeno.'; exit 0; }
    if [ "$poweroff_after_validation" = yes ]; then
        if systemctl is-active --quiet consolepi-generic-image-preparation.service; then
            fail 'generic image preparation už běží'
        fi
        systemd-run --unit=consolepi-generic-image-preparation --collect \
            --property=Type=exec /usr/local/sbin/consolepi-prepare-generic-image \
            --poweroff-internal >/dev/null
        printf '%s\n' 'Sanitizace a validace pokračuje nezávisle na SSH.'
        printf '%s\n' 'Zařízení se vypne pouze při výsledku PASS.'
        printf '%s\n' 'Stav lze z lokální konzole sledovat příkazem:'
        printf '%s\n' '  journalctl -fu consolepi-generic-image-preparation.service'
        exit 0
    fi
fi

destructive=yes
install -m 0600 "$prep_dir/recovery.txt" "$RECOVERY"
rm -f "$STATE_DIR/generic-image-validation.json"
systemctl disable --now ssh nginx consolepi-web consolepi-port-monitor \
    consolepi-update-check.timer snmpd lldpd >/dev/null 2>&1 || true
# Generic firstboot owns host-key creation. Prevent the vendor first-boot unit
# from racing it; standard installations never execute this sanitization path.
if systemctl list-unit-files regenerate_ssh_host_keys.service --no-legend 2>/dev/null | grep -q .; then
    systemctl disable regenerate_ssh_host_keys.service >/dev/null ||
        fail 'nelze deaktivovat vendor regeneraci SSH host keys'
    if systemctl is-enabled regenerate_ssh_host_keys.service >/dev/null 2>&1; then
        fail 'vendor regenerace SSH host keys zůstala enabled'
    fi
fi

# Remove password hashes, then lock both accounts.
passwd -d consolepi >/dev/null
passwd -l consolepi >/dev/null
passwd -d console >/dev/null 2>&1 || true
passwd -l console >/dev/null 2>&1 || true
rm -f "$STATE_DIR/generic-imager-customization-failed" "$STATE_DIR/generic-imager-customization-imported" \
    "$STATE_DIR/.generic-imager-ssh-operation" "$STATE_DIR/.generic-imager-user-operation" \
    "$STATE_DIR/generic-imager-audit.jsonl" "$STATE_DIR/generic-recovery-active"

# No pre-existing login key may survive in a generic image.
find /root /home -xdev -type f -path '*/.ssh/*' -delete 2>/dev/null || true
find /root /home -xdev -type f \( -name '.bash_history' -o -name '.zsh_history' -o -name '.python_history' \) -delete 2>/dev/null || true
rm -f /etc/ssh/ssh_host_* /etc/consolepi/tls/consolepi.key \
    /etc/consolepi/tls/consolepi.crt /etc/consolepi/web.secret /etc/consolepi/web.auth
rm -f /etc/apt/apt.conf.d/90consolepi-proxy /var/lib/snmp/snmpd.conf
rm -rf /var/backups/consolepi
rm -f /etc/udev/rules.d/70-consolepi.rules
find /var/log/consolepi /var/log/nginx -type f -delete 2>/dev/null || true
journalctl --rotate >/dev/null 2>&1 || true
journalctl --vacuum-time=1s >/dev/null 2>&1 || true
rm -f /var/lib/systemd/random-seed /var/lib/dbus/machine-id
install -o root -g root -m 0444 "$prep_dir/machine-id" /etc/.machine-id.consolepi-new
mv -f /etc/.machine-id.consolepi-new /etc/machine-id

# Network allowlist: discard every runtime profile and create one plain DHCP Ethernet profile.
install -d -m 0700 /etc/NetworkManager/system-connections
find /etc/NetworkManager/system-connections -mindepth 1 -delete 2>/dev/null || true
install -m 0600 "$prep_dir/wired-generic.nmconnection" \
    "/etc/NetworkManager/system-connections/Wired connection 1.nmconnection"
find /etc/wpa_supplicant /etc/openvpn /etc/wireguard -mindepth 1 -delete 2>/dev/null || true
rm -rf /var/lib/rpi-connect /root/.config/rpi-connect /home/consolepi/.config/rpi-connect
rm -f /etc/ppp/chap-secrets /etc/ppp/pap-secrets
find /etc/ppp/peers -mindepth 1 -delete 2>/dev/null || true
find /var/lib/dhcp /var/lib/NetworkManager -type f -delete 2>/dev/null || true
hostnamectl set-hostname consolepi
find /var/lib/consolepi-web -mindepth 1 -delete 2>/dev/null || true
python3 - "$boot_mount" <<'PY'
import sys
sys.path.insert(0, "/usr/local/lib")
from consolepi_imager_security import clear_directory, sanitize_boot_partition
clear_directory("/var/lib/cloud")
sanitize_boot_partition(sys.argv[1])
PY

# Generic-only Raspberry Pi Imager 2.x compatibility. Imager owns and executes
# the FAT firstrun payload. These guards constrain its two vendor entrypoints;
# firstboot validates the resulting transaction before creating success.
mv "$VENDOR_CUSTOM" "$VENDOR_CUSTOM.consolepi-vendor"
install -o root -g root -m 0755 "$prep_dir/imager-custom-guard" "$VENDOR_CUSTOM.new"
mv -f "$VENDOR_CUSTOM.new" "$VENDOR_CUSTOM"
mv "$VENDOR_USERCONF" "$VENDOR_USERCONF.consolepi-vendor"
install -o root -g root -m 0755 "$prep_dir/imager-userconf-guard" "$VENDOR_USERCONF.new"
mv -f "$VENDOR_USERCONF.new" "$VENDOR_USERCONF"
boot_relative=${boot_mount#/boot/}
python3 - /boot/cmdline.txt <<'PY'
import sys
sys.path.insert(0, "/usr/local/lib")
from consolepi_imager_security import remove_legacy_cmdline_placeholder
remove_legacy_cmdline_placeholder(sys.argv[1])
PY
if [ -L /boot/cmdline.txt ]; then
    [ "$(readlink /boot/cmdline.txt)" = "$boot_relative/cmdline.txt" ] ||
        fail '/boot/cmdline.txt má neočekávaný symlink target'
else
    ln -s "$boot_relative/cmdline.txt" /boot/cmdline.txt
fi

install -m 0600 "$prep_dir/imager-systemd-compat" "$STATE_DIR/.imager-systemd-compat.new"
mv -f "$STATE_DIR/.imager-systemd-compat.new" "$STATE_DIR/imager-systemd-compat"
install -m 0600 "$prep_dir/imager-boot-mount" "$STATE_DIR/.imager-boot-mount.new"
mv -f "$STATE_DIR/.imager-boot-mount.new" "$STATE_DIR/imager-boot-mount"

# Install reset configuration atomically from files prepared during preflight.
for name in radius.json radius-secrets.json pam_radius_auth.conf snmpv3.json snmpv3-secrets.json proxy.json access-sources.json identity.json labels.json auth.conf firstboot.json; do
    mode=0600
    case "$name" in radius.json|access-sources.json|identity.json|labels.json|auth.conf) mode=0644 ;; esac
    install -m "$mode" "$prep_dir/$name" "$STATE_DIR/.$name.new"
    mv -f "$STATE_DIR/.$name.new" "$STATE_DIR/$name"
done
python3 - "$STATE_DIR/generic-image.json" <<'PY'
import sys
sys.path.insert(0, "/usr/local/lib")
from consolepi_firstboot_security import write_generic_state
write_generic_state(sys.argv[1], "pending")
PY

install -d -m 0755 /etc/ssh/sshd_config.d
install -m 0644 "$prep_dir/generic-ssh.conf" /etc/ssh/sshd_config.d/39-consolepi-generic-image.conf
for service in ssh nginx consolepi-web; do
    install -d -m 0755 "/etc/systemd/system/$service.service.d"
    install -m 0644 "$prep_dir/dependency.conf" "/etc/systemd/system/$service.service.d/consolepi-generic-image.conf"
done

systemctl daemon-reload
systemctl enable consolepi-generic-image-firstboot.service consolepi-generic-recovery.service ssh nginx \
    consolepi-web consolepi-port-monitor consolepi-update-check.timer >/dev/null

/usr/local/sbin/consolepi-validate-generic-image || fail 'post-sanitizační validace selhala'
if [ "$poweroff_after_validation" = yes ]; then
    sync
    printf '%s\n' 'Master je validní; zařízení se nyní vypne.'
    systemctl poweroff
else
    printf '%s\n' 'Master je sanitizován a validace skončila PASS.'
    printf '%s\n' 'Vypněte jej bez dalšího síťového startu:'
    printf '%s\n' '  systemctl poweroff'
    printf '%s\n' 'Teprve potom pořiďte image vypnuté karty.'
fi
