#!/usr/bin/python3
"""Read-only ConsolePi metrics for Net-SNMP pass_persist."""
import json
import shutil
import subprocess
from pathlib import Path

ROOT = "1.3.6.1.4.1.55555.1"
SERVICES = ("ssh", "nginx", "consolepi-web", "consolepi-port-monitor", "nftables", "lldpd", "snmpd")
PORTS_CONFIG = Path("/etc/consolepi/ports.conf")
UPDATE_STATE = Path("/var/lib/consolepi-web/update-status.json")
previous_cpu = None


def cpu_percent():
    global previous_cpu
    fields = [int(value) for value in Path("/proc/stat").read_text().splitlines()[0].split()[1:]]
    total = sum(fields)
    idle = fields[3] + (fields[4] if len(fields) > 4 else 0)
    old = previous_cpu
    previous_cpu = (total, idle)
    if not old or total <= old[0]:
        return 0
    return round(max(0, min(100, 100 * ((total - old[0]) - (idle - old[1])) / (total - old[0]))))


def update_status():
    """Return cached update state only; SNMP must not run APT or use the network."""
    try:
        value = json.loads(UPDATE_STATE.read_text())
        return max(0, int(value.get("updates", 0))), int(bool(value.get("reboot_required", False)))
    except (OSError, ValueError, json.JSONDecodeError):
        return 0, 0


def ethernet_link_state():
    try:
        state = Path("/sys/class/net/eth0/operstate").read_text().strip().lower()
    except OSError:
        return 2
    return 1 if state == "up" else 2


def serial_ports():
    """Return fixed ConsolePi ports without exposing device paths or serial data."""
    rows = []
    try:
        lines = PORTS_CONFIG.read_text().splitlines()
    except OSError:
        return rows
    for line in lines:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        fields = line.split("|", 2)
        if len(fields) != 3 or not fields[0].isdigit():
            continue
        ssh_port, label, device = fields
        if device.startswith("/dev/consolepi/unassigned-"):
            state = 1
        elif Path(device).exists():
            state = 3
        else:
            state = 2
        rows.append((int(ssh_port), label, state))
    return rows


def metrics():
    memory = {}
    for line in Path("/proc/meminfo").read_text().splitlines():
        name, _, amount = line.partition(":")
        memory[name] = int(amount.strip().split()[0]) * 1024
    total = memory.get("MemTotal", 0)
    used = max(0, total - memory.get("MemAvailable", 0))
    disk = shutil.disk_usage("/")
    temperature = Path("/sys/class/thermal/thermal_zone0/temp")
    temp_deci = int(int(temperature.read_text().strip()) / 100) if temperature.exists() else 0
    updates, reboot_required = update_status()
    values = {
        f"{ROOT}.1.0": ("gauge", cpu_percent()),
        f"{ROOT}.2.0": ("integer", temp_deci),
        f"{ROOT}.3.0": ("counter64", used),
        f"{ROOT}.4.0": ("counter64", total),
        f"{ROOT}.5.0": ("gauge", round(100 * used / total) if total else 0),
        f"{ROOT}.6.0": ("counter64", disk.total - disk.free),
        f"{ROOT}.7.0": ("counter64", disk.total),
        f"{ROOT}.8.0": ("gauge", round(100 * (disk.total - disk.free) / disk.total) if disk.total else 0),
        f"{ROOT}.9.0": ("timeticks", int(float(Path("/proc/uptime").read_text().split()[0]) * 100)),
        f"{ROOT}.10.0": ("gauge", updates),
        f"{ROOT}.11.0": ("integer", reboot_required),
        f"{ROOT}.12.0": ("integer", ethernet_link_state()),
    }
    for index, service in enumerate(SERVICES, 1):
        active = subprocess.run(("systemctl", "is-active", service), capture_output=True, text=True).stdout.strip() == "active"
        values[f"{ROOT}.20.1.1.2.{index}"] = ("string", service)
        values[f"{ROOT}.20.1.1.3.{index}"] = ("integer", 1 if active else 2)
    for ssh_port, label, state in serial_ports():
        # The SSH port is the stable SNMP table index; it is deliberately not
        # exported as a second value because the OID instance already carries it.
        values[f"{ROOT}.30.1.1.2.{ssh_port}"] = ("string", label)
        values[f"{ROOT}.30.1.1.3.{ssh_port}"] = ("integer", state)
    return values


def ordered(values):
    return sorted(values, key=lambda oid: tuple(int(part) for part in oid.split(".")))


def answer(operation, oid):
    values = metrics()
    keys = ordered(values)
    target = oid.lstrip(".")
    if operation == "get":
        result = target if target in values else None
    else:
        result = next((key for key in keys if tuple(map(int, key.split("."))) > tuple(map(int, target.split(".")))), None)
    if not result:
        print("NONE", flush=True)
        return
    kind, value = values[result]
    print(result, kind, value, sep="\n", flush=True)


def main():
    while True:
        operation = input().strip().lower()
        if operation == "ping":
            print("PONG", flush=True)
        elif operation in {"get", "getnext"}:
            answer(operation, input().strip())
        else:
            print("NONE", flush=True)


if __name__ == "__main__":
    main()
