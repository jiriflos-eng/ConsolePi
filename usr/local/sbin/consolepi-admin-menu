#!/bin/sh
set -u

PATH=/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

is_remote() {
    [ -n "${SSH_CONNECTION:-}" ]
}

pause() {
    printf '\nStisknete Enter pro navrat do menu...'
    IFS= read -r _
}

show_network() {
    printf '\nAktualni nastaveni Ethernetu\n'
    nmcli -f GENERAL.DEVICE,GENERAL.STATE,GENERAL.CONNECTION,IP4.ADDRESS,IP4.GATEWAY,IP4.DNS device show eth0 2>/dev/null ||
        printf '%s\n' 'Stav rozhrani nelze nacist.'
}

confirm_pending() {
    if sudo /usr/local/sbin/consolepi-control network pending-status 2>/dev/null | grep -q '"active": true'; then
        printf '\n\033[33mExistuje nepotvrzena zmena site.\033[0m\n'
        printf 'Je nove pripojeni funkcni a chcete nastaveni potvrdit? [a/N]: '
        IFS= read -r answer
        case "$answer" in
            a|A|ano|ANO)
                sudo /usr/local/sbin/consolepi-control network confirm-pending &&
                    printf '%s\n' 'Sitove nastaveni bylo potvrzeno.'
                ;;
            *)
                printf '%s\n' 'Nastaveni zatim nebylo potvrzeno; pojistka obnovi puvodni sit.'
                ;;
        esac
    fi
}

configure_network() {
    show_network
    if is_remote; then
        printf '%s\n' \
            'Pokud menite ConsolePi do jine site nez ma administrator, nejprve ji pridejte volbou Povolene management site (firewall).'
    fi
    printf '\nVyberte rezim: [1] DHCP  [2] Staticka adresa  [0] Zpet\nVolba: '
    IFS= read -r mode
    case "$mode" in
        1)
            printf 'Pouzit DHCP? [a/N]: '
            IFS= read -r answer
            case "$answer" in
                a|A|ano|ANO)
                    if is_remote; then
                        printf '%s\n' 'SSH spojeni muze byt ukonceno. Po prihlaseni potvrdte novou sit v menu.'
                    fi
                    sudo /usr/local/sbin/consolepi-control network apply dhcp
                    ;;
            esac
            ;;
        2)
            current_address=$(nmcli -g IP4.ADDRESS device show eth0 2>/dev/null | head -n1)
            current_ip=${current_address%/*}
            current_prefix=${current_address#*/}
            current_gateway=$(nmcli -g IP4.GATEWAY device show eth0 2>/dev/null | head -n1)
            current_dns=$(nmcli -g IP4.DNS device show eth0 2>/dev/null | paste -sd, -)
            printf 'IP adresa [%s]: ' "$current_ip"
            IFS= read -r address
            address=${address:-$current_ip}
            printf 'Prefix/maska CIDR [%s]: ' "$current_prefix"
            IFS= read -r prefix
            prefix=${prefix:-$current_prefix}
            printf 'Vychozi brana [%s]: ' "$current_gateway"
            IFS= read -r gateway
            gateway=${gateway:-$current_gateway}
            printf 'DNS, vice adres oddelte carkou [%s]: ' "$current_dns"
            IFS= read -r dns
            dns=${dns:-$current_dns}
            printf '\nPouzit %s/%s, brana %s, DNS %s? [a/N]: ' \
                "$address" "$prefix" "$gateway" "$dns"
            IFS= read -r answer
            case "$answer" in
                a|A|ano|ANO)
                    if is_remote; then
                        printf '%s\n' 'SSH spojeni muze byt ukonceno. Pripojte se na novou IP a zmenu potvrdte v menu.'
                    fi
                    sudo /usr/local/sbin/consolepi-control network apply static \
                        "$address" "$prefix" "$gateway" "$dns"
                    ;;
            esac
            ;;
    esac
}

show_access_sources() {
    python3 -c '
import json
import sys

status = json.load(sys.stdin)
print("\nPovolene management site")
print("  [automaticky] lokalni Ethernet: {}".format(status["local_network"]))
sources = status.get("sources", [])
if not sources:
    print("  Zadna dalsi sit neni povolena.")
else:
    for index, source in enumerate(sources, 1):
        print("  [{}] {}: {}".format(index, source["label"], source["network"]))
'
}

configure_access_sources() {
    while :; do
        access_status=$(sudo /usr/local/sbin/consolepi-control access status) || {
            printf '%s\n' 'Seznam povolenych siti nelze nacist.'
            return
        }
        if ! printf '%s\n' "$access_status" | show_access_sources; then
            printf '%s\n' 'Seznam povolenych siti neni platny.'
            return
        fi
        printf '\n[1] Pridat sit  [2] Odebrat sit  [0] Zpet\nVolba: '
        IFS= read -r action
        case "$action" in
            1)
                printf 'Popis site: '
                IFS= read -r label
                printf 'IPv4 sit v CIDR tvaru (napr. 192.168.50.0/24): '
                IFS= read -r network
                confirmation=
                if [ "$network" = 0.0.0.0/0 ]; then
                    printf '%s\n' 'VAROVANI: 0.0.0.0/0 povoli management ze vsech IPv4 adres.'
                    printf 'Pro potvrzeni napiste presne POVOLIT VSEM: '
                    IFS= read -r confirmation
                    # Backend vyzaduje ceskou variantu s diakritikou. Menu
                    # prijima ASCII text, aby fungovalo na kazdem terminalu.
                    [ "$confirmation" = "POVOLIT VSEM" ] && confirmation="POVOLIT VŠEM"
                fi
                if sudo /usr/local/sbin/consolepi-control access add \
                    "$label" "$network" "$confirmation" >/dev/null; then
                    printf '%s\n' 'Management sit byla pridana a firewall aktualizovan.'
                else
                    printf '%s\n' 'Sit se nepodarilo pridat; firewall zustal beze zmeny.'
                fi
                ;;
            2)
                printf 'Cislo site k odebrani: '
                IFS= read -r index
                case "$index" in
                    ''|*[!0-9]*)
                        printf '%s\n' 'Neplatne cislo.'
                        continue
                        ;;
                esac
                source_id=$(
                    printf '%s\n' "$access_status" |
                        python3 -c '
import json
import sys

index = int(sys.argv[1])
sources = json.load(sys.stdin).get("sources", [])
if index < 1 or index > len(sources):
    raise SystemExit(1)
print(sources[index - 1]["id"])
' "$index"
                ) || {
                    printf '%s\n' 'Polozka s timto cislem neexistuje.'
                    continue
                }
                printf 'Odebrat vybranou management sit? [a/N]: '
                IFS= read -r answer
                case "$answer" in
                    a|A|ano|ANO)
                        if sudo /usr/local/sbin/consolepi-control access delete \
                            "$source_id" >/dev/null; then
                            printf '%s\n' 'Management sit byla odebrana a firewall aktualizovan.'
                        else
                            printf '%s\n' 'Sit se nepodarilo odebrat; firewall zustal beze zmeny.'
                        fi
                        ;;
                esac
                ;;
            0) return ;;
            *) printf '%s\n' 'Neplatna volba.' ;;
        esac
    done
}

factory_reset() {
    printf '\n\033[31mTOVARNI RESET\033[0m\n'
    printf '%s\n' 'Nastavi DHCP, vymaze prirazeni USB kabelu, RADIUS, seriove predvolby a souborove zaznamy relaci.'
    printf '%s\n' 'Hesla spravce, SSH host klice, HTTPS certifikat a pristupove udaje zustanou zachovane.'
    printf 'Pro potvrzeni napiste presne RESET: '
    IFS= read -r confirmation
    if [ "$confirmation" != "RESET" ]; then
        printf '%s\n' 'Reset byl zrusen.'
        return
    fi
    printf 'Opravdu pokracovat? [a/N]: '
    IFS= read -r answer
    case "$answer" in
        a|A|ano|ANO)
            printf '%s\n' 'Probiha tovarni reset. Sitove spojeni muze byt ukonceno...'
            printf '%s\n' 'RESET' |
                sudo /usr/local/sbin/consolepi-control factory reset
            ;;
        *) printf '%s\n' 'Reset byl zrusen.' ;;
    esac
}

confirm_pending

while :; do
    clear
    /usr/local/sbin/consolepi-login-status
    printf '%s\n' '  [1] Obnovit stav'
    printf '%s\n' '  [2] Nastaveni site (DHCP / staticka IPv4)'
    printf '%s\n' '  [3] Povolene management site (firewall)'
    printf '%s\n' '  [4] Diagnostika ConsolePi'
    printf '%s\n' '  [5] Obnovit tovarni nastaveni'
    printf '%s\n' '  [6] Prejit do shellu'
    printf '%s\n' '  [7] Obnovit heslo webove administrace'
    printf '%s\n' '  [0] Odhlasit'
    printf '\nVolba: '
    IFS= read -r choice || exit 0
    case "$choice" in
        1) ;;
        2) configure_network; pause ;;
        3) configure_access_sources; pause ;;
        4) sudo /usr/local/sbin/consolepi-diagnose; pause ;;
        5) factory_reset; pause ;;
        6) printf '%s\n' 'Prechazim do administracniho shellu.'; exec /bin/bash --noprofile --norc ;;
        7) sudo /usr/local/sbin/consolepi-reset-web-password; pause ;;
        0) exit 0 ;;
        *) printf '%s\n' 'Neplatna volba.'; pause ;;
    esac
done
