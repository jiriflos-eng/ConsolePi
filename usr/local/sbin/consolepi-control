#!/usr/bin/python3
import ipaddress
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
import time
import pwd
import fcntl
import gzip
from urllib.parse import quote
from urllib.parse import urlparse
from pathlib import Path

STATE_DIR = Path("/var/lib/consolepi-web")
STATE = STATE_DIR / "network-rollback.json"
CONNECTION = "Wired connection 1"
ROLLBACK_UNIT = "consolepi-network-rollback"
APPLY_UNIT = "consolepi-network-apply"
NETWORK_ROLLBACK_SECONDS = 180
NFTABLES = Path("/etc/nftables.conf")
AUTHORIZED_KEYS = Path("/home/console/.ssh/authorized_keys")
SERIAL_CONFIG = Path("/etc/consolepi/serial.conf")
PORTS_CONFIG = Path("/etc/consolepi/ports.conf")
AUTH_CONFIG = Path("/etc/consolepi/auth.conf")
RADIUS_META = Path("/etc/consolepi/radius.json")
RADIUS_SECRETS = Path("/etc/consolepi/radius-secrets.json")
PAM_RADIUS_CONFIG = Path("/etc/consolepi/pam_radius_auth.conf")
PAM_RADIUS_SERVICE = Path("/etc/pam.d/consolepi-radius")
PAM_SSHD = Path("/etc/pam.d/sshd")
SSH_DROPIN = Path("/etc/ssh/sshd_config.d/40-consolepi.conf")
WEB_AUTH = Path("/etc/consolepi/web.auth")
CONSOLE_CONFIG = Path("/etc/consolepi/consolepi.conf")
UDEV_RULES = Path("/etc/udev/rules.d/70-consolepi.rules")
LOG_ROOT = Path("/var/log/consolepi")
LOG_MAINTAIN = Path("/usr/local/sbin/consolepi-log-maintain")
UPDATE_STATE = Path("/var/lib/consolepi-web/update-status.json")
PROXY_CONFIG = Path("/etc/consolepi/proxy.json")
APT_PROXY_CONFIG = Path("/etc/apt/apt.conf.d/90consolepi-proxy")
APT_SOURCES_CONFIG = Path("/etc/consolepi/apt-sources.json")
APT_SOURCE_PARTS = Path("/etc/apt/sources.list.d")
DEBIAN_SOURCES = APT_SOURCE_PARTS / "debian.sources"
RASPI_SOURCES = APT_SOURCE_PARTS / "raspi.sources"
LABELS_CONFIG = Path("/etc/consolepi/labels.json")
FIRSTBOOT_CONFIG = Path("/etc/consolepi/firstboot.json")
GENERIC_IMAGE_CONFIG = Path("/etc/consolepi/generic-image.json")
IDENTITY_CONFIG = Path("/etc/consolepi/identity.json")
HOSTS_CONFIG = Path("/etc/hosts")
DISCOVERY_CONFIG = Path("/etc/consolepi/discovery.json")
LLDP_DEFAULTS = Path("/etc/default/lldpd")
ACCESS_SOURCES_CONFIG = Path("/etc/consolepi/access-sources.json")
SNMP_CONFIG = Path("/etc/consolepi/snmpv3.json")
SNMP_SECRETS = Path("/etc/consolepi/snmpv3-secrets.json")
SNMPD_CONFIG = Path("/etc/snmp/snmpd.conf")
SNMPD_PERSISTENT = Path("/var/lib/snmp/snmpd.conf")
SNMPD_MIB = Path("/usr/share/snmp/mibs/CONSOLEPI-MIB.txt")


def run(*args, check=True):
    return subprocess.run(args, check=check, text=True, capture_output=True)


def nm_get(field):
    return run("nmcli", "-g", field, "connection", "show", CONNECTION).stdout.strip()


def save_state(token, candidate):
    try:
        previous_address, _ = active_network()
    except (IndexError, subprocess.CalledProcessError):
        previous_address = ""
    state = {
        "token": token,
        "method": nm_get("ipv4.method"),
        "addresses": nm_get("ipv4.addresses"),
        "gateway": nm_get("ipv4.gateway"),
        "dns": nm_get("ipv4.dns"),
        "nftables": NFTABLES.read_text(),
        "candidate": candidate,
        "previous_address": previous_address,
        "phase": "staged",
    }
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    STATE.write_text(json.dumps(state))
    os.chmod(STATE, 0o600)


def restore():
    state = json.loads(STATE.read_text())
    run(
        "nmcli", "connection", "modify", CONNECTION,
        "ipv4.method", state["method"],
        "ipv4.addresses", state["addresses"],
        "ipv4.gateway", state["gateway"],
        "ipv4.dns", state["dns"],
    )
    run("nmcli", "connection", "up", CONNECTION)
    NFTABLES.write_text(state["nftables"])
    os.chmod(NFTABLES, 0o755)
    run("nft", "-f", str(NFTABLES))
    STATE.unlink(missing_ok=True)


def active_network():
    address = run(
        "nmcli", "-g", "IP4.ADDRESS", "device", "show", "eth0"
    ).stdout.splitlines()[0]
    interface = ipaddress.IPv4Interface(address)
    return str(interface.ip), str(interface.network)


def wait_for_active_network(timeout=30):
    """Wait for NetworkManager to publish the new IPv4 address.

    ``nmcli connection up`` may return while eth0 is still transitioning.  A
    direct read at that instant is empty, even though the activation succeeds
    milliseconds later.  Do not lose the rollback state because of that race.
    """
    until = time.monotonic() + timeout
    last_error = None
    while time.monotonic() < until:
        try:
            return active_network()
        except (IndexError, ValueError, subprocess.CalledProcessError) as error:
            last_error = error
            time.sleep(0.25)
    raise RuntimeError("NetworkManager včas nepřidělil IPv4 adresu.") from last_error


def normalise_source(label, network, source_id=None):
    label = " ".join(str(label).split())
    if not 1 <= len(label) <= 80 or any(character in label for character in "<>\x00"):
        raise ValueError("Popis zdroje musí mít 1 až 80 běžných znaků.")
    source_id = source_id or secrets.token_hex(8)
    if not re.fullmatch(r"[a-f0-9]{16}", source_id):
        raise ValueError("Neplatný identifikátor zdroje přístupu.")
    return {
        "id": source_id,
        "label": label,
        "network": str(ipaddress.IPv4Network(str(network).strip(), strict=False)),
    }


def access_sources():
    try:
        raw = json.loads(ACCESS_SOURCES_CONFIG.read_text())
        values = raw.get("sources", [])
    except (OSError, json.JSONDecodeError):
        values = []
    if not isinstance(values, list):
        raise ValueError("Seznam povolených zdrojů není platný.")
    records = []
    for value in values:
        if not isinstance(value, dict):
            raise ValueError("Seznam povolených zdrojů není platný.")
        record = normalise_source(value.get("label", ""), value.get("network", ""), value.get("id"))
        if record["id"] in {item["id"] for item in records}:
            raise ValueError("Seznam povolených zdrojů obsahuje duplicitní ID.")
        if record["network"] in {item["network"] for item in records}:
            raise ValueError("Seznam povolených zdrojů obsahuje duplicitní síť.")
        records.append(record)
    return records


def write_access_sources(records):
    ACCESS_SOURCES_CONFIG.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    temporary = ACCESS_SOURCES_CONFIG.with_suffix(".new")
    temporary.write_text(json.dumps({"sources": records}, indent=2, ensure_ascii=False) + "\n")
    os.chmod(temporary, 0o644)
    temporary.replace(ACCESS_SOURCES_CONFIG)


def render_firewall(network, sources, generic_bootstrap=False):
    local = str(ipaddress.IPv4Network(network, strict=False))
    requested_networks = [ipaddress.IPv4Network(local)]
    requested_networks.extend(
        ipaddress.IPv4Network(record["network"], strict=False)
        for record in sources
    )
    # nftables interval sets reject overlapping ranges. Canonicalize the
    # allow-list first, so 0.0.0.0/0 safely supersedes narrower networks.
    networks = [str(item) for item in ipaddress.collapse_addresses(requested_networks)]
    elements = ", ".join(networks)
    snmp_rule = "        ip saddr @management_ipv4_networks udp dport 161 ct state new accept\n" if snmp_status_data()["enabled"] else ""
    bootstrap_rule = "        ip saddr 0.0.0.0/0 tcp dport { 22, 80, 443 } ct state new accept\n" if generic_bootstrap else ""
    return f'''#!/usr/sbin/nft -f

flush ruleset

table inet consolepi_filter {{
    set management_ipv4_networks {{
        type ipv4_addr
        flags interval
        elements = {{ {elements} }}
    }}

    set console_ssh_ports {{
        type inet_service
        elements = {{ 22, 2201, 2202, 2203, 2204 }}
    }}

    chain input {{
        type filter hook input priority filter; policy drop;

        iifname "lo" accept
        ct state invalid drop
        ct state established,related accept
        ip protocol icmp accept
        ip6 nexthdr ipv6-icmp accept
{bootstrap_rule}
        # Link-local mDNS discovery for ConsolePi.  It is not routed beyond
        # the Ethernet segment and must also survive firewall regeneration.
        ip daddr 224.0.0.251 udp dport 5353 accept
        ip saddr @management_ipv4_networks tcp dport @console_ssh_ports ct state new accept
        ip saddr @management_ipv4_networks tcp dport 80 ct state new accept
        ip saddr @management_ipv4_networks tcp dport 443 ct state new accept
{snmp_rule}        # Povolené zdroje se do drop logu nezapisují. To zahrnuje
        # i 0.0.0.0/0, pokud správce vědomě otevře přístup všem.
        # Nevyzadane DHCP klientské broadcasty zahodit bez zahlcovani journalu.
        ip saddr 0.0.0.0 ip daddr 255.255.255.255 udp sport 68 udp dport 67 counter drop
        # packet is still rejected when the log rate limit is exhausted.
        ip saddr != @management_ipv4_networks limit rate 10/minute burst 20 packets log prefix "nft-input-drop: " level info
        counter drop
    }}

    chain forward {{
        type filter hook forward priority filter; policy drop;
    }}

    chain output {{
        type filter hook output priority filter; policy accept;
    }}
}}
'''


def update_firewall(network, generic_bootstrap=False):
    ipaddress.IPv4Network(network, strict=False)
    updated = render_firewall(network, access_sources(), generic_bootstrap)
    candidate = STATE_DIR / "nftables.candidate"
    candidate.write_text(updated)
    run("nft", "-c", "-f", str(candidate))
    NFTABLES.write_text(updated)
    os.chmod(NFTABLES, 0o755)
    run("nft", "-f", str(NFTABLES))
    candidate.unlink(missing_ok=True)


def access_status():
    _, local_network = active_network()
    records = access_sources()
    print(json.dumps({
        "local_network": local_network,
        "sources": records,
        "open_access": any(record["network"] == "0.0.0.0/0" for record in records),
    }, ensure_ascii=False))


def access_validate_confirmation(record, confirmation):
    if record["network"] == "0.0.0.0/0" and confirmation != "POVOLIT VŠEM":
        raise ValueError("Pro 0.0.0.0/0 napište potvrzení PŘESNĚ: POVOLIT VŠEM.")


def access_add(label, network, confirmation):
    record = normalise_source(label, network)
    access_validate_confirmation(record, confirmation)
    records = access_sources()
    _, local_network = active_network()
    if record["network"] == local_network:
        raise ValueError("Tato síť je již povolena automaticky jako lokální Ethernet.")
    if record["network"] in {item["network"] for item in records}:
        raise ValueError("Tato IP adresa nebo síť už v seznamu existuje.")
    records.append(record)
    write_access_sources(records)
    update_firewall(local_network)
    run("logger", "-p", "authpriv.notice", "-t", "consolepi", f"ACCESS_SOURCE_ADD id={record['id']} network={record['network']}")
    print(json.dumps(record, ensure_ascii=False))


def access_update(source_id, label, network, confirmation):
    records = access_sources()
    record = normalise_source(label, network, source_id)
    access_validate_confirmation(record, confirmation)
    existing = next((item for item in records if item["id"] == source_id), None)
    if existing is None:
        raise ValueError("Povolený zdroj nebyl nalezen.")
    _, local_network = active_network()
    if record["network"] == local_network:
        raise ValueError("Tato síť je již povolena automaticky jako lokální Ethernet.")
    if record["network"] in {item["network"] for item in records if item["id"] != source_id}:
        raise ValueError("Tato IP adresa nebo síť už v seznamu existuje.")
    records[records.index(existing)] = record
    write_access_sources(records)
    update_firewall(local_network)
    run("logger", "-p", "authpriv.notice", "-t", "consolepi", f"ACCESS_SOURCE_UPDATE id={record['id']} network={record['network']}")
    print(json.dumps(record, ensure_ascii=False))


def access_delete(source_id):
    records = access_sources()
    remaining = [item for item in records if item["id"] != source_id]
    if len(remaining) == len(records):
        raise ValueError("Povolený zdroj nebyl nalezen.")
    write_access_sources(remaining)
    _, local_network = active_network()
    update_firewall(local_network)
    run("logger", "-p", "authpriv.notice", "-t", "consolepi", f"ACCESS_SOURCE_DELETE id={source_id}")
    print(json.dumps({"deleted": source_id}))


def access_migrate():
    if not ACCESS_SOURCES_CONFIG.exists():
        write_access_sources([])
    _, local_network = active_network()
    # DHCP changes and update installs may run after generic first-boot has
    # opened its temporary setup transports.  Preserve that access until the
    # setup transaction explicitly finalizes it to a management allow-list.
    sys.path.insert(0, "/usr/local/lib")
    from consolepi_firstboot_security import (
        ClaimError, firstboot_reason, generic_web_setup_pending,
    )
    bootstrap = False
    if firstboot_reason(FIRSTBOOT_CONFIG) == "generic_image":
        try:
            bootstrap = generic_web_setup_pending(
                FIRSTBOOT_CONFIG, GENERIC_IMAGE_CONFIG
            )
        except ClaimError:
            # Do not leave public setup transports active for corrupt state.
            update_firewall(local_network, generic_bootstrap=False)
            raise
    update_firewall(local_network, generic_bootstrap=bootstrap)


def access_generic_bootstrap():
    """Open only setup transports while an intact generic claim is pending."""
    sys.path.insert(0, "/usr/local/lib")
    from consolepi_firstboot_security import generic_web_setup_pending
    if not generic_web_setup_pending(
            "/etc/consolepi/firstboot.json", "/etc/consolepi/generic-image.json"):
        raise ValueError("Dočasný generic přístup není v tomto stavu povolen.")
    _, local_network = active_network()
    update_firewall(local_network, generic_bootstrap=True)


def access_firstboot_finalize(networks_value, client_address):
    """Persist management CIDRs and remove public setup access."""
    sys.path.insert(0, "/usr/local/lib")
    from consolepi_firstboot_security import (
        generic_web_setup_pending, parse_management_networks,
    )
    if not generic_web_setup_pending(
            "/etc/consolepi/firstboot.json", "/etc/consolepi/generic-image.json"):
        raise ValueError("Generic first-boot dokončení není v tomto stavu povoleno.")
    requested = parse_management_networks(networks_value, client_address)
    _, local_network = active_network()
    records = [
        normalise_source(f"First-boot management {index}", network)
        for index, network in enumerate(requested, 1)
        if network != local_network
    ]
    write_access_sources(records)
    update_firewall(local_network)


def firewall_drops():
    """Return recent, rate-limited firewall drop messages for the web UI."""
    result = run(
        "journalctl", "-k", "-g", "nft-input-drop", "-n", "100",
        "--no-pager", "-o", "short-iso", check=False,
    )
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "Výpis firewallového logu není dostupný.")
    _, local_network = active_network()
    allowed_networks = [ipaddress.IPv4Network(local_network, strict=False)]
    allowed_networks.extend(
        ipaddress.IPv4Network(record["network"], strict=False)
        for record in access_sources()
    )
    entries = []
    for line in result.stdout.splitlines():
        timestamp = line.split(" ", 1)[0] if line else ""
        fields = dict(re.findall(r"([A-Z]+)=([^ ]*)", line))
        try:
            source_address = ipaddress.ip_address(fields.get("SRC", ""))
        except ValueError:
            continue
        # The current rule logs IPv4 only, but journal history can contain old
        # IPv6 and local multicast entries. Keep the web view useful by hiding
        # both those old records and every source in the local Ethernet range.
        if source_address.version != 4 or any(source_address in network for network in allowed_networks):
            continue
        entries.append({
            "timestamp": timestamp,
            "source": fields.get("SRC", "–"),
            "source_port": fields.get("SPT", "–"),
            "destination_port": fields.get("DPT", "–"),
            "protocol": fields.get("PROTO", "–"),
        })
    print(json.dumps({"entries": entries}, ensure_ascii=False))


def apply(args):
    if len(args) not in (1, 5) or args[0] not in ("dhcp", "static"):
        raise ValueError("Neplatné parametry síťové konfigurace.")
    if STATE.exists():
        raise ValueError("Nejprve potvrďte nebo nechte vrátit předchozí síťovou změnu.")
    mode = args[0]
    if mode == "dhcp":
        candidate = {"mode": "dhcp", "address": "", "prefix": "", "gateway": "", "dns": ""}
    else:
        address, prefix, gateway, dns = args[1:]
        ipaddress.IPv4Interface(f"{address}/{prefix}")
        ipaddress.IPv4Address(gateway)
        for item in dns.split(","):
            ipaddress.ip_address(item.strip())
        candidate = {
            "mode": "static",
            "address": address,
            "prefix": prefix,
            "gateway": gateway,
            "dns": dns,
        }
    token = secrets.token_urlsafe(24)
    run("systemctl", "stop", f"{APPLY_UNIT}.timer", check=False)
    run("systemctl", "stop", f"{APPLY_UNIT}.service", check=False)
    run("systemctl", "stop", f"{ROLLBACK_UNIT}.timer", check=False)
    run("systemctl", "stop", f"{ROLLBACK_UNIT}.service", check=False)
    save_state(token, candidate)
    try:
        run(
            "systemd-run", f"--unit={APPLY_UNIT}", "--on-active=5s", "--collect",
            "/usr/local/sbin/consolepi-control", "network", "activate", token,
        )
    except subprocess.CalledProcessError:
        STATE.unlink(missing_ok=True)
        raise
    print(json.dumps({
        "address": candidate["address"],
        "mode": mode,
        "delay": 5,
    }))


def activate(token):
    state = json.loads(STATE.read_text())
    if not secrets.compare_digest(state["token"], token):
        raise ValueError("Neplatný aktivační token.")
    candidate = state.get("candidate")
    if not isinstance(candidate, dict) or candidate.get("mode") not in ("dhcp", "static"):
        raise ValueError("Neplatný stav připravené síťové změny.")
    deadline = int(time.time()) + NETWORK_ROLLBACK_SECONDS
    run(
        "systemd-run", "--unit", ROLLBACK_UNIT,
        f"--on-active={NETWORK_ROLLBACK_SECONDS}",
        "/usr/local/sbin/consolepi-control", "network", "rollback", token,
    )
    if candidate["mode"] == "dhcp":
        run(
            "nmcli", "connection", "modify", CONNECTION,
            "ipv4.method", "auto", "ipv4.addresses", "",
            "ipv4.gateway", "", "ipv4.dns", "",
        )
    else:
        address = candidate.get("address", "")
        prefix = candidate.get("prefix", "")
        gateway = candidate.get("gateway", "")
        dns = candidate.get("dns", "")
        ipaddress.IPv4Interface(f"{address}/{prefix}")
        ipaddress.IPv4Address(gateway)
        for item in dns.split(","):
            ipaddress.ip_address(item.strip())
        run(
            "nmcli", "connection", "modify", CONNECTION,
            "ipv4.method", "manual", "ipv4.addresses", f"{address}/{prefix}",
            "ipv4.gateway", gateway, "ipv4.dns", dns,
        )
    run("nmcli", "connection", "up", CONNECTION)
    address, network = wait_for_active_network()
    update_firewall(network)
    state["phase"] = "active"
    state["rollback_deadline"] = deadline
    STATE.write_text(json.dumps(state))
    os.chmod(STATE, 0o600)
    print(json.dumps({"address": address}))


def confirm(token):
    state = json.loads(STATE.read_text())
    if state.get("phase", "active") != "active":
        raise ValueError("Síťová změna ještě není aktivní.")
    if not secrets.compare_digest(state["token"], token):
        raise ValueError("Neplatný potvrzovací token.")
    run("systemctl", "stop", f"{ROLLBACK_UNIT}.timer", check=False)
    STATE.unlink(missing_ok=True)


def pending_status():
    if not STATE.exists():
        return {"active": False}
    state = json.loads(STATE.read_text())
    deadline = state.get("rollback_deadline")
    active = state.get("phase") == "active" and isinstance(deadline, int)
    return {
        "active": active,
        "remaining_seconds": max(0, deadline - int(time.time())) if active else 0,
        "previous_address": state.get("previous_address", "") if active else "",
    }


def key_fingerprint(line):
    result = subprocess.run(
        ("ssh-keygen", "-lf", "-", "-E", "sha256"),
        input=line + "\n",
        check=True,
        text=True,
        capture_output=True,
    )
    parts = result.stdout.split()
    if len(parts) < 4:
        raise ValueError("Neplatný formát veřejného SSH klíče.")
    key_fields = line.split(maxsplit=2)
    comment = key_fields[2] if len(key_fields) == 3 else parts[1]
    return parts[1], comment


def read_key_lines():
    return [
        line.strip()
        for line in AUTHORIZED_KEYS.read_text().splitlines()
        if line.strip() and not line.lstrip().startswith("#")
    ]


def write_key_lines(lines):
    console_user = pwd.getpwnam("console")
    fd, temporary = tempfile.mkstemp(
        prefix=".authorized_keys.", dir=str(AUTHORIZED_KEYS.parent)
    )
    try:
        with os.fdopen(fd, "w") as handle:
            handle.write("\n".join(lines) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.chown(temporary, console_user.pw_uid, console_user.pw_gid)
        os.replace(temporary, AUTHORIZED_KEYS)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def keys_list():
    records = []
    for line in read_key_lines():
        fingerprint, comment = key_fingerprint(line)
        records.append({"fingerprint": fingerprint, "comment": comment})
    print(json.dumps(records))


def keys_add(public_line):
    fields = public_line.split()
    if len(fields) not in (2, 3) or fields[0] != "ssh-ed25519":
        raise ValueError("Povolen je pouze veřejný klíč typu Ed25519.")
    fingerprint, _ = key_fingerprint(public_line)
    lines = read_key_lines()
    if any(key_fingerprint(line)[0] == fingerprint for line in lines):
        raise ValueError("Tento veřejný klíč je již nainstalován.")
    lines.append(public_line)
    write_key_lines(lines)
    print(json.dumps({"fingerprint": fingerprint}))


def keys_delete(fingerprint):
    if not re.fullmatch(r"SHA256:[A-Za-z0-9+/]{20,60}={0,2}", fingerprint):
        raise ValueError("Neplatný fingerprint.")
    lines = read_key_lines()
    remaining = [
        line for line in lines if key_fingerprint(line)[0] != fingerprint
    ]
    if len(remaining) == len(lines):
        raise ValueError("Klíč nebyl nalezen.")
    if not remaining and auth_mode() == "local_key":
        raise ValueError(
            "Poslední přístupový klíč nelze odstranit, dokud je aktivní "
            "autentizace SSH klíčem."
        )
    write_key_lines(remaining)


def serial_records():
    records = {}
    for line in SERIAL_CONFIG.read_text().splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        fields = line.split("|")
        if len(fields) != 7:
            raise ValueError("Neplatný formát serial.conf.")
        records[fields[0]] = fields
    return records


def validate_serial(values):
    port, baud, databits, parity, stopbits, flow, local_echo = values
    if not port.isdigit():
        raise ValueError("Neplatný SSH port.")
    if baud not in {"9600", "19200", "38400", "57600", "115200"}:
        raise ValueError("Nepovolená rychlost.")
    if databits not in {"7", "8"}:
        raise ValueError("Nepovolený počet datových bitů.")
    if parity not in {"none", "even", "odd"}:
        raise ValueError("Nepovolená parita.")
    if stopbits not in {"1", "2"}:
        raise ValueError("Nepovolený počet stop bitů.")
    if flow not in {"none", "hard", "soft"}:
        raise ValueError("Nepovolený flow control.")
    if local_echo not in {"yes", "no"}:
        raise ValueError("Nepovolené local echo.")


def port_name(port):
    for line in PORTS_CONFIG.read_text().splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        fields = line.split("|", 2)
        if fields[0] == port:
            return fields[1]
    raise ValueError("SSH port není nakonfigurován.")


def port_records():
    """Read the port map while keeping its order and human-readable names."""
    records = []
    for line in PORTS_CONFIG.read_text().splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        port, name, device = line.split("|", 2)
        records.append([port, name, device])
    if not records:
        raise ValueError("Nejsou nakonfigurovány konzolové porty.")
    return records


def write_port_records(records):
    lines = ["# SSH_PORT|DEVICE_NAME|SERIAL_DEVICE"]
    lines.extend("|".join(record) for record in records)
    atomic_write(PORTS_CONFIG, "\n".join(lines) + "\n", 0o644)


def serial_devices():
    """Return physically present USB serial adapters through stable by-id paths."""
    root = Path("/dev/serial/by-id")
    if not root.is_dir():
        return []
    return sorted(
        path for path in root.iterdir()
        if path.is_symlink() and path.name.startswith("usb-") and path.exists()
    )


def ports_discover():
    assigned = {record[2] for record in port_records()}
    devices = [str(path) for path in serial_devices() if str(path) not in assigned]
    print(json.dumps(devices))


def ports_assign(port, stable_id):
    if not re.fullmatch(r"usb-[A-Za-z0-9._-]+", stable_id):
        raise ValueError("Neplatný identifikátor USB sériového adaptéru.")
    device = Path("/dev/serial/by-id") / stable_id
    if not device.is_symlink() or not device.exists():
        raise ValueError("Vybraný USB sériový adaptér už není připojený.")

    lock = ensure_console_free(port)
    try:
        records = port_records()
        matches = [record for record in records if record[0] == port]
        if len(matches) != 1:
            raise ValueError("SSH port není nakonfigurován.")
        if any(record[2] == str(device) and record[0] != port for record in records):
            raise ValueError("Tento USB adaptér je již přiřazen jinému SSH portu.")
        matches[0][2] = str(device)
        write_port_records(records)
    finally:
        lock.close()
    print(json.dumps({"port": port, "device": str(device)}))


def ports_unassign(port):
    lock = ensure_console_free(port)
    try:
        records = port_records()
        for index, record in enumerate(records, start=1):
            if record[0] == port:
                record[2] = f"/dev/consolepi/unassigned-{index}"
                write_port_records(records)
                print(json.dumps({"port": port, "unassigned": True}))
                return
        raise ValueError("SSH port není nakonfigurován.")
    finally:
        lock.close()


def ensure_console_free(port):
    name = port_name(port)
    lock_path = Path("/run/lock/consolepi") / f"{name}.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    # Tento nástroj běží přes sudo jako root, ale vlastní sériová relace běží
    # pod omezeným účtem console. Zámek proto musí zůstat zapisovatelný pro
    # účet console i tehdy, když ho poprvé vytvoří administrativní operace.
    lock_path.touch(exist_ok=True)
    console_user = pwd.getpwnam("console")
    os.chown(lock_path, console_user.pw_uid, console_user.pw_gid)
    os.chmod(lock_path, 0o664)
    handle = lock_path.open("a")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        raise ValueError("Konzole je právě obsazena; nastavení nelze změnit.")
    return handle


def write_serial_records(records):
    lines = ["# SSH_PORT|BAUD|DATABITS|PARITY|STOPBITS|FLOW|LOCAL_ECHO"]
    for port in sorted(records, key=int):
        lines.append("|".join(records[port]))
    temporary = SERIAL_CONFIG.with_name(".serial.conf.new")
    temporary.write_text("\n".join(lines) + "\n")
    os.chmod(temporary, 0o644)
    os.replace(temporary, SERIAL_CONFIG)


def serial_list():
    print(json.dumps(list(serial_records().values())))


def serial_set(values):
    validate_serial(values)
    lock = ensure_console_free(values[0])
    try:
        records = serial_records()
        if values[0] not in records:
            raise ValueError("SSH port není v serial.conf.")
        records[values[0]] = values
        write_serial_records(records)
    finally:
        lock.close()


def serial_reset(port):
    serial_set([port, "9600", "8", "none", "1", "none", "no"])


def label_set(port):
    port_name(port)
    value = sys.stdin.read(1024).strip()
    if len(value) > 120 or any(ord(character) < 32 for character in value):
        raise ValueError("Popisek smí mít nejvýše 120 znaků a jeden řádek.")
    labels = {}
    if LABELS_CONFIG.exists():
        labels = json.loads(LABELS_CONFIG.read_text() or "{}")
    if value:
        labels[port] = value
    else:
        labels.pop(port, None)
    atomic_write(LABELS_CONFIG, json.dumps(labels, indent=2) + "\n", 0o644)
    print(json.dumps({"port": port, "label": value}))


def atomic_write(path, text, mode):
    temporary = path.with_name(f".{path.name}.new")
    temporary.write_text(text)
    os.chmod(temporary, mode)
    os.replace(temporary, path)


def proxy_defaults():
    return {
        "enabled": False, "scheme": "http", "host": "", "port": 8080,
        "username": "", "password": "",
        "no_proxy": "localhost,127.0.0.1,::1",
    }


def read_proxy_config():
    values = proxy_defaults()
    if PROXY_CONFIG.exists():
        stored = json.loads(PROXY_CONFIG.read_text())
        if isinstance(stored, dict):
            values.update(stored)
    return values


def proxy_status():
    values = read_proxy_config()
    print(json.dumps({
        "enabled": bool(values["enabled"]),
        "scheme": values["scheme"],
        "host": values["host"],
        "port": values["port"],
        "username": values["username"],
        "password_set": bool(values["password"]),
        "no_proxy": values["no_proxy"],
    }))


def proxy_configure():
    payload = json.loads(sys.stdin.read(16384))
    current = read_proxy_config()
    enabled = bool(payload.get("enabled"))
    scheme = str(payload.get("scheme", "http")).strip().lower()
    host = str(payload.get("host", "")).strip()
    username = str(payload.get("username", "")).strip()
    password = str(payload.get("password", ""))
    no_proxy = str(payload.get("no_proxy", "")).strip()
    if not password and bool(payload.get("keep_password")):
        password = str(current.get("password", ""))
    if scheme not in {"http", "https"}:
        raise ValueError("Proxy podporuje pouze protokol HTTP nebo HTTPS.")
    try:
        port = int(payload.get("port", 8080))
    except (TypeError, ValueError):
        raise ValueError("Port proxy musí být číslo.")
    if not 1 <= port <= 65535:
        raise ValueError("Port proxy musí být v rozsahu 1 až 65535.")
    if enabled:
        if not host or len(host) > 253 or not re.fullmatch(
            r"[A-Za-z0-9._:-]+", host
        ):
            raise ValueError("Zadejte platný název nebo IP adresu proxy serveru.")
        if (username and not password) or (password and not username):
            raise ValueError("U proxy autentizace vyplňte uživatele i heslo.")
    if any(character in no_proxy for character in '\r\n"'):
        raise ValueError("Seznam výjimek proxy obsahuje nepovolené znaky.")
    values = {
        "enabled": enabled, "scheme": scheme, "host": host, "port": port,
        "username": username, "password": password if enabled else "",
        "no_proxy": no_proxy,
    }
    atomic_write(PROXY_CONFIG, json.dumps(values, indent=2) + "\n", 0o600)
    if enabled:
        credentials = ""
        if username:
            credentials = f"{quote(username, safe='')}:{quote(password, safe='')}@"
        uri = f"{scheme}://{credentials}{host}:{port}/"
        lines = [
            "// Spravováno ConsolePi.",
            f'Acquire::http::Proxy "{uri}";',
            f'Acquire::https::Proxy "{uri}";',
        ]
        for item in (part.strip() for part in no_proxy.split(",")):
            if item:
                lines.extend([
                    f'Acquire::http::Proxy::{item} "DIRECT";',
                    f'Acquire::https::Proxy::{item} "DIRECT";',
                ])
        atomic_write(APT_PROXY_CONFIG, "\n".join(lines) + "\n", 0o600)
    else:
        APT_PROXY_CONFIG.unlink(missing_ok=True)
    run(
        "logger", "-p", "authpriv.notice", "-t", "consolepi",
        f"PROXY_CONFIG enabled={'yes' if enabled else 'no'} "
        f"host={host if enabled else '-'} port={port}",
    )
    proxy_status()


def apt_sources_defaults():
    """Return the supported Raspberry Pi OS core repositories.

    ConsolePi deliberately manages only the distribution source files it owns.
    Separately installed administrator files in ``sources.list.d`` are never
    deleted or rewritten.
    """
    codename = "bookworm"
    try:
        for line in Path("/etc/os-release").read_text().splitlines():
            if line.startswith("VERSION_CODENAME="):
                value = line.partition("=")[2].strip().strip('"')
                if re.fullmatch(r"[a-z0-9-]{2,32}", value):
                    codename = value
                break
    except OSError:
        pass
    return {
        "mode": "official",
        "codename": codename,
        "debian_uri": "http://deb.debian.org/debian",
        "security_uri": "http://security.debian.org/debian-security",
        "raspberrypi_uri": "http://archive.raspberrypi.com/debian",
    }


def read_apt_sources_config():
    values = apt_sources_defaults()
    try:
        stored = json.loads(APT_SOURCES_CONFIG.read_text())
        if isinstance(stored, dict):
            values.update({key: stored[key] for key in values if key in stored})
    except (OSError, ValueError, json.JSONDecodeError):
        pass
    return values


def validate_apt_uri(value, label):
    """Accept only a plain HTTP(S) repository base URI.

    APT source syntax permits many additional options.  The web interface must
    not expose that grammar: no credentials, query strings, fragments, newline
    injection or embedded source options are accepted here.
    """
    value = str(value).strip().rstrip("/")
    if not value or len(value) > 512 or any(character in value for character in "\r\n\\\""):
        raise ValueError(f"{label} není platná URL repozitáře.")
    parsed = urlparse(value)
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        raise ValueError(f"{label} musí začínat http:// nebo https://.")
    if parsed.username or parsed.password or parsed.query or parsed.fragment:
        raise ValueError(f"{label} nesmí obsahovat přihlašovací údaje ani parametry URL.")
    if not re.fullmatch(r"[A-Za-z0-9._:-]+", parsed.netloc):
        raise ValueError(f"{label} obsahuje nepovolený název serveru.")
    if not re.fullmatch(r"(?:/[A-Za-z0-9._~:@%+,-]+)*", parsed.path or ""):
        raise ValueError(f"{label} obsahuje nepovolenou cestu.")
    if any(part in {".", ".."} for part in parsed.path.split("/")):
        raise ValueError(f"{label} obsahuje nepovolenou cestu.")
    return value


def render_apt_sources(values):
    codename = str(values["codename"])
    if not re.fullmatch(r"[a-z0-9-]{2,32}", codename):
        raise ValueError("Kódové označení systému není podporované.")
    debian = values["debian_uri"]
    security = values["security_uri"]
    raspberrypi = values["raspberrypi_uri"]
    return {
        "debian.sources": (
            "# Spravováno ConsolePi. Ručně neupravujte.\n"
            "Types: deb\n"
            f"URIs: {debian}\n"
            f"Suites: {codename} {codename}-updates\n"
            "Components: main\n"
            "Architectures: arm64\n"
            "Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\n"
            "Types: deb\n"
            f"URIs: {security}\n"
            f"Suites: {codename}-security\n"
            "Components: main\n"
            "Architectures: arm64\n"
            "Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg\n"
        ),
        "raspi.sources": (
            "# Spravováno ConsolePi. Ručně neupravujte.\n"
            "Types: deb\n"
            f"URIs: {raspberrypi}\n"
            f"Suites: {codename}\n"
            "Components: main\n"
            "Architectures: arm64\n"
            "Signed-By: /usr/share/keyrings/raspberrypi-archive-keyring.gpg\n"
        ),
    }


def verify_apt_sources(files):
    """Refresh candidate lists without touching the system APT cache."""
    with tempfile.TemporaryDirectory(prefix="consolepi-apt-sources-") as temporary:
        root = Path(temporary)
        parts = root / "sources.list.d"
        lists = root / "lists"
        parts.mkdir(mode=0o755)
        lists.mkdir(mode=0o755)
        for name, text in files.items():
            (parts / name).write_text(text)
        result = run(
            "apt-get",
            "-o", "Dir::Etc::sourcelist=-",
            "-o", f"Dir::Etc::sourceparts={parts}",
            "-o", f"Dir::State::Lists={lists}",
            "-o", "APT::Get::List-Cleanup=0",
            "update", check=False,
        )
    if result.returncode:
        message = (result.stderr or result.stdout).strip().splitlines()
        raise ValueError(message[-1] if message else "Ověření APT repozitářů selhalo.")


def apt_sources_status():
    values = read_apt_sources_config()
    print(json.dumps({
        "mode": values["mode"], "codename": values["codename"],
        "debian_uri": values["debian_uri"], "security_uri": values["security_uri"],
        "raspberrypi_uri": values["raspberrypi_uri"],
        "managed": DEBIAN_SOURCES.exists() and RASPI_SOURCES.exists(),
    }))


def apply_apt_sources(values, verify=True):
    files = render_apt_sources(values)
    if verify:
        verify_apt_sources(files)
    APT_SOURCE_PARTS.mkdir(mode=0o755, parents=True, exist_ok=True)
    for name, text in files.items():
        atomic_write(APT_SOURCE_PARTS / name, text, 0o644)
    atomic_write(APT_SOURCES_CONFIG, json.dumps(values, indent=2) + "\n", 0o644)
    run("logger", "-p", "authpriv.notice", "-t", "consolepi",
        f"APT_SOURCES mode={values['mode']} debian={values['debian_uri']} "
        f"security={values['security_uri']} raspberrypi={values['raspberrypi_uri']}")
    apt_sources_status()


def apt_sources_configure():
    payload = json.loads(sys.stdin.read(8192))
    mode = str(payload.get("mode", "official")).strip().lower()
    if mode not in {"official", "mirror"}:
        raise ValueError("Vyberte oficiální zdroje nebo vlastní mirror.")
    values = apt_sources_defaults()
    values["mode"] = mode
    if mode == "mirror":
        values["debian_uri"] = validate_apt_uri(payload.get("debian_uri", ""), "Debian mirror")
        values["security_uri"] = validate_apt_uri(payload.get("security_uri", ""), "Security mirror")
        values["raspberrypi_uri"] = validate_apt_uri(payload.get("raspberrypi_uri", ""), "Raspberry Pi mirror")
    apply_apt_sources(values, verify=True)


def apt_sources_reset():
    # Used by generic image sanitization.  Do not require network access there.
    apply_apt_sources(apt_sources_defaults(), verify=False)


def discovery_defaults():
    return {"lldp": False, "cdp": False}


def read_discovery_config():
    values = discovery_defaults()
    try:
        stored = json.loads(DISCOVERY_CONFIG.read_text())
        if isinstance(stored, dict):
            values.update({key: bool(stored.get(key)) for key in values})
    except (OSError, json.JSONDecodeError):
        pass
    return values


def lldp_neighbors():
    result = run("lldpctl", "-f", "keyvalue", check=False)
    if result.returncode:
        return [], result.stderr.strip() or "Informace o sousedech nejsou dostupné."
    records = {}
    for line in result.stdout.splitlines():
        key, separator, value = line.partition("=")
        if not separator or not key.startswith("lldp."):
            continue
        parts = key.split(".")
        if len(parts) < 3:
            continue
        interface = parts[1]
        record = records.setdefault(interface, {
            "interface": interface, "protocol": "", "name": "",
            "platform": "", "port": "", "address": "",
        })
        suffix = ".".join(parts[2:])
        if suffix == "via":
            record["protocol"] = value.upper()
        elif suffix.endswith("chassis.name"):
            record["name"] = value
        elif suffix.endswith("chassis.descr"):
            record["platform"] = value
        elif suffix.endswith("chassis.mgmt-ip"):
            record["address"] = value
        elif suffix.endswith("port.descr") or suffix.endswith("port.id.value"):
            if not record["port"]:
                record["port"] = value
    return list(records.values()), ""


def discovery_status():
    values = read_discovery_config()
    active = run("systemctl", "is-active", "lldpd", check=False).stdout.strip() == "active"
    neighbors, error = lldp_neighbors() if active else ([], "")
    print(json.dumps({**values, "active": active, "neighbors": neighbors, "error": error}))


def discovery_configure():
    try:
        values = json.loads(sys.stdin.read(4096) or "{}")
    except json.JSONDecodeError as exc:
        raise ValueError("Neplatné nastavení sousedské detekce.") from exc
    selected = {"lldp": bool(values.get("lldp")), "cdp": bool(values.get("cdp"))}
    atomic_write(DISCOVERY_CONFIG, json.dumps(selected, indent=2) + "\n", 0o644)
    if not any(selected.values()):
        run("systemctl", "disable", "--now", "lldpd", check=False)
        discovery_status()
        return
    options = ["-I", "eth0", "-k"]
    if selected["cdp"]:
        options.append("-c")
    if not selected["lldp"]:
        options.append("-ll")
    atomic_write(LLDP_DEFAULTS, 'DAEMON_ARGS="' + " ".join(options) + '"\n', 0o644)
    started = run("systemctl", "enable", "--now", "lldpd", check=False)
    if started.returncode:
        raise ValueError(started.stderr.strip() or "Službu lldpd nelze spustit.")
    run("systemctl", "restart", "lldpd")
    run(
        "logger", "-p", "authpriv.notice", "-t", "consolepi",
        f"DISCOVERY_CONFIG lldp={selected['lldp']} cdp={selected['cdp']}",
    )
    discovery_status()


def snmp_defaults():
    return {"enabled": False, "username": "", "auth_protocol": "SHA-256", "privacy_protocol": "AES"}


def snmp_status_data():
    values = snmp_defaults()
    try:
        stored = json.loads(SNMP_CONFIG.read_text())
        if isinstance(stored, dict):
            values.update({key: stored.get(key, value) for key, value in values.items()})
    except (OSError, json.JSONDecodeError):
        pass
    installed = shutil.which("snmpd") is not None
    active = installed and run("systemctl", "is-active", "snmpd", check=False).stdout.strip() == "active"
    values.update({"installed": installed, "active": active, "mib_available": SNMPD_MIB.exists(), "port": 161,
                   "oid_root": "1.3.6.1.4.1.55555.1"})
    return values


def snmp_status():
    print(json.dumps(snmp_status_data(), ensure_ascii=False))


def write_snmpd_config(values):
    location = "ConsolePi"
    try:
        location = str(json.loads(IDENTITY_CONFIG.read_text()).get("location") or location).replace('"', "")
    except (OSError, json.JSONDecodeError):
        pass
    text = f'''# Spravováno ConsolePi – pouze SNMPv3 authPriv.\nagentAddress udp:161\nsysLocation "{location}"\nsysContact "ConsolePi"\nview consolepi included .1.3.6.1.4.1.55555.1\nrouser {values["username"]} priv -V consolepi\npass_persist .1.3.6.1.4.1.55555.1 /usr/local/sbin/consolepi-snmp-pass-persist\n'''
    atomic_write(SNMPD_CONFIG, text, 0o600)


def snmp_configure():
    try:
        payload = json.loads(sys.stdin.read(4096) or "{}")
    except json.JSONDecodeError as exc:
        raise ValueError("Nastavení SNMPv3 nemá platný formát.") from exc
    enabled = payload.get("enabled") is True
    if not enabled:
        atomic_write(SNMP_CONFIG, json.dumps(snmp_defaults(), indent=2) + "\n", 0o600)
        _, network = active_network()
        update_firewall(network)
        run("systemctl", "disable", "--now", "snmpd", check=False)
        run("logger", "-p", "authpriv.notice", "-t", "consolepi", "SNMPV3 disabled")
        snmp_status()
        return
    if not shutil.which("snmpd"):
        raise ValueError("Balíček snmpd není nainstalovaný. Dokončete instalaci ConsolePi 1.3.0.")
    username = str(payload.get("username", "")).strip()
    auth_password = str(payload.get("auth_password", ""))
    privacy_password = str(payload.get("privacy_password", ""))
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_.-]{2,31}", username):
        raise ValueError("Uživatel SNMPv3 musí mít 3 až 32 znaků: písmena, číslice, tečka, pomlčka nebo podtržítko.")
    for label, password in (("Autentizační", auth_password), ("Šifrovací", privacy_password)):
        if len(password) < 8 or len(password) > 128 or any(character.isspace() for character in password):
            raise ValueError(f"{label} heslo SNMPv3 musí mít 8 až 128 znaků bez mezer.")
    values = {"enabled": True, "username": username, "auth_protocol": "SHA-256", "privacy_protocol": "AES"}
    atomic_write(SNMP_CONFIG, json.dumps(values, indent=2) + "\n", 0o600)
    atomic_write(SNMP_SECRETS, json.dumps({"auth_password": auth_password, "privacy_password": privacy_password}) + "\n", 0o600)
    write_snmpd_config(values)
    run("systemctl", "stop", "snmpd", check=False)
    SNMPD_PERSISTENT.unlink(missing_ok=True)
    SNMPD_PERSISTENT.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    atomic_write(SNMPD_PERSISTENT, f"createUser {username} SHA-256 {auth_password} AES {privacy_password}\n", 0o600)
    _, network = active_network()
    update_firewall(network)
    started = run("systemctl", "enable", "--now", "snmpd", check=False)
    if started.returncode:
        raise ValueError(started.stderr.strip() or "Službu SNMPv3 nelze spustit.")
    run("logger", "-p", "authpriv.notice", "-t", "consolepi", f"SNMPV3 configured user={username}")
    snmp_status()


def auth_mode():
    if not AUTH_CONFIG.exists():
        return "local_key"
    match = re.search(
        r"^AUTH_MODE=(local|local_key|local_password|radius)$",
        AUTH_CONFIG.read_text(),
        re.MULTILINE,
    )
    if not match:
        raise ValueError("Neplatný soubor auth.conf.")
    return "local_key" if match.group(1) == "local" else match.group(1)


def console_password_set():
    for line in Path("/etc/shadow").read_text().splitlines():
        if line.startswith("console:"):
            value = line.split(":", 2)[1]
            return bool(value and not value.startswith(("!", "*")))
    return False


def radius_metadata():
    defaults = {
        "primary_host": "",
        "primary_port": 1812,
        "primary_secret_set": False,
        "secondary_host": "",
        "secondary_port": 1812,
        "secondary_secret_set": False,
        "timeout": 3,
        "retries": 1,
        "radius_last_check": "",
        "radius_last_check_ok": False,
    }
    if RADIUS_META.exists():
        defaults.update(json.loads(RADIUS_META.read_text()))
    return defaults


def radius_secrets():
    if not RADIUS_SECRETS.exists():
        return {"primary": "", "secondary": ""}
    data = json.loads(RADIUS_SECRETS.read_text())
    return {
        "primary": str(data.get("primary", "")),
        "secondary": str(data.get("secondary", "")),
    }


def validate_radius_host(value, label):
    if not value:
        return
    if len(value) > 253 or not re.fullmatch(
        r"(?=.{1,253}$)[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?", value
    ):
        raise ValueError(f"Neplatná adresa {label} RADIUS serveru.")
    if ".." in value:
        raise ValueError(f"Neplatná adresa {label} RADIUS serveru.")


def validate_radius_secret(value, label):
    if value and (
        len(value) < 8
        or len(value) > 128
        or any(character.isspace() for character in value)
    ):
        raise ValueError(
            f"Shared secret {label} serveru musí mít 8–128 znaků bez mezer."
        )


def render_ssh_dropin(mode):
    ports = []
    for line in PORTS_CONFIG.read_text().splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        port = line.split("|", 1)[0]
        if not port.isdigit():
            raise ValueError("Neplatný port v ports.conf.")
        ports.append(port)
    if not ports:
        raise ValueError("Nejsou nakonfigurovány konzolové porty.")

    lines = [
        "# Spravováno ConsolePi. Port 22 zůstává pro administraci.",
        "Port 22",
        *[f"Port {port}" for port in ports],
        "",
    ]
    for port in ports:
        lines.extend(
            [
                f"Match User console LocalPort {port}",
                "    ForceCommand /usr/local/sbin/consolepi-session",
                (
                    "    AuthenticationMethods publickey"
                    if mode == "local_key"
                    else (
                        "    AuthenticationMethods password"
                        if mode == "local_password"
                        else "    AuthenticationMethods keyboard-interactive:pam"
                    )
                ),
                f"    PubkeyAuthentication {'yes' if mode == 'local_key' else 'no'}",
                f"    PasswordAuthentication {'yes' if mode == 'local_password' else 'no'}",
                (
                    "    KbdInteractiveAuthentication no"
                    if mode != "radius"
                    else "    KbdInteractiveAuthentication yes"
                ),
                "    PermitTTY yes",
                "    AllowTcpForwarding no",
                "    AllowAgentForwarding no",
                "    X11Forwarding no",
                "    PermitTunnel no",
                "    GatewayPorts no",
                "",
            ]
        )
    lines.extend(
        [
            "# Účet console nikdy nezíská shell ani na jiném portu.",
            "Match User console",
            "    ForceCommand /usr/local/sbin/consolepi-session",
            "    AuthenticationMethods publickey",
            "    PubkeyAuthentication yes",
            "    PasswordAuthentication no",
            "    KbdInteractiveAuthentication no",
            "    PermitTTY yes",
            "    AllowTcpForwarding no",
            "    AllowAgentForwarding no",
            "    X11Forwarding no",
            "    PermitTunnel no",
            "    GatewayPorts no",
            "",
        ]
    )
    return "\n".join(lines)


def render_pam_sshd(retries, mode):
    original = PAM_SSHD.read_text()
    begin = "# BEGIN CONSOLEPI RADIUS"
    end = "# END CONSOLEPI RADIUS"
    pattern = rf"\n?{re.escape(begin)}.*?{re.escape(end)}\n?"
    cleaned = re.sub(pattern, "\n", original, flags=re.DOTALL)
    if mode != "radius":
        return cleaned
    marker = "@include common-auth"
    if marker not in cleaned:
        raise ValueError("/etc/pam.d/sshd neobsahuje očekávaný common-auth.")
    block = "\n".join(
        [
            begin,
            "auth [success=3 default=ignore] pam_succeed_if.so user != console",
            "auth requisite pam_consolepi_user.so",
            "auth requisite pam_radius_auth.so "
            "conf=/etc/consolepi/pam_radius_auth.conf try_first_pass "
            f"retry={retries} client_id=ConsolePi",
            "auth [success=done default=die] pam_consolepi_user.so restore",
            end,
            "",
        ]
    )
    return cleaned.replace(marker, block + marker, 1)


def apply_authentication_files(mode, retries):
    old_ssh = SSH_DROPIN.read_text()
    old_pam = PAM_SSHD.read_text()
    try:
        atomic_write(SSH_DROPIN, render_ssh_dropin(mode), 0o644)
        atomic_write(PAM_SSHD, render_pam_sshd(retries, mode), 0o644)
        run("sshd", "-t")
        ssh_active = (
            run("systemctl", "is-active", "ssh", check=False).stdout.strip()
            == "active"
        )
        if ssh_active:
            run("systemctl", "reload", "ssh")
    except Exception:
        atomic_write(SSH_DROPIN, old_ssh, 0o644)
        atomic_write(PAM_SSHD, old_pam, 0o644)
        ssh_active = (
            run("systemctl", "is-active", "ssh", check=False).stdout.strip()
            == "active"
        )
        if ssh_active:
            run("systemctl", "reload", "ssh", check=False)
        raise


def auth_status():
    metadata = radius_metadata()
    metadata["mode"] = auth_mode()
    metadata["local_password_set"] = console_password_set()
    print(json.dumps(metadata))


def auth_sync():
    metadata = radius_metadata()
    apply_authentication_files(auth_mode(), int(metadata.get("retries", 1)))


def radius_server_check(host, port, secret, timeout, label):
    """Prove a RADIUS server and secret with an intentionally invalid user."""
    username = f"consolepi-health-{secrets.token_hex(12)}"
    password = secrets.token_urlsafe(24)
    try:
        result = subprocess.run(
            ("radtest", username, password, host, "0", secret, str(port)),
            text=True, capture_output=True, timeout=timeout + 3, check=False,
        )
        output = f"{result.stdout}\n{result.stderr}"
    except (OSError, subprocess.TimeoutExpired):
        output = ""
    if "Access-Reject" in output:
        return
    if "Access-Accept" in output:
        raise ValueError(f"RADIUS test {label} serveru vrátil neočekávaný Access-Accept.")
    raise ValueError(
        f"RADIUS test {label} serveru {host}:{port} selhal: "
        "bez odpovědi nebo neplatná odpověď."
    )


def auth_configure():
    raw = sys.stdin.read(8193)
    if len(raw) > 8192:
        raise ValueError("RADIUS konfigurace je příliš velká.")
    payload = json.loads(raw)
    mode = str(payload.get("mode", ""))
    if mode not in {"local_key", "local_password", "radius"}:
        raise ValueError("Neplatný režim autentizace.")

    local_password = str(payload.get("local_password", ""))
    local_password_confirmation = str(
        payload.get("local_password_confirmation", "")
    )
    if local_password or local_password_confirmation:
        if local_password != local_password_confirmation:
            raise ValueError("Lokální hesla se neshodují.")
        if len(local_password) < 10 or len(local_password) > 128:
            raise ValueError("Lokální heslo musí mít 10–128 znaků.")
        subprocess.run(
            ("/usr/sbin/chpasswd",),
            input=f"console:{local_password}\n",
            check=True,
            text=True,
            capture_output=True,
        )
    if mode == "local_password" and not console_password_set():
        raise ValueError(
            "Před aktivací heslového režimu nastavte lokální heslo."
        )
    if mode == "local_key" and not read_key_lines():
        raise ValueError(
            "Režim SSH klíče vyžaduje alespoň jeden oprávněný veřejný klíč."
        )

    metadata = radius_metadata()
    stored_secrets = radius_secrets()
    primary_host = str(payload.get("primary_host", "")).strip()
    secondary_enabled = bool(payload.get("secondary_enabled", False))
    secondary_host = (
        str(payload.get("secondary_host", "")).strip()
        if secondary_enabled else ""
    )
    validate_radius_host(primary_host, "primárního")
    validate_radius_host(secondary_host, "sekundárního")
    try:
        primary_port = int(payload.get("primary_port", 1812))
        secondary_port = int(payload.get("secondary_port", 1812))
        timeout = int(payload.get("timeout", 3))
        retries = int(payload.get("retries", 1))
    except (TypeError, ValueError):
        raise ValueError("Port, timeout a počet pokusů musí být čísla.")
    if not 1 <= primary_port <= 65535 or not 1 <= secondary_port <= 65535:
        raise ValueError("RADIUS port musí být v rozsahu 1–65535.")
    if not 3 <= timeout <= 60:
        raise ValueError("RADIUS timeout musí být 3–60 sekund.")
    if not 1 <= retries <= 3:
        raise ValueError("Počet pokusů musí být 1–3.")

    primary_secret = str(payload.get("primary_secret", ""))
    secondary_secret = (
        str(payload.get("secondary_secret", "")) if secondary_enabled else ""
    )
    validate_radius_secret(primary_secret, "primárního")
    validate_radius_secret(secondary_secret, "sekundárního")
    if primary_secret:
        stored_secrets["primary"] = primary_secret
    if secondary_secret:
        stored_secrets["secondary"] = secondary_secret
    if not primary_host:
        stored_secrets["primary"] = ""
    if not secondary_host:
        stored_secrets["secondary"] = ""

    if mode == "radius" and (not primary_host or not stored_secrets["primary"]):
        raise ValueError("RADIUS režim vyžaduje primární server a shared secret.")
    if secondary_host and not stored_secrets["secondary"]:
        raise ValueError("Sekundární RADIUS server vyžaduje shared secret.")
    if mode == "radius":
        radius_server_check(
            primary_host, primary_port, stored_secrets["primary"], timeout,
            "primárního",
        )
        if secondary_host:
            radius_server_check(
                secondary_host, secondary_port, stored_secrets["secondary"], timeout,
                "sekundárního",
            )

    pam_lines = [
        "# Spravováno ConsolePi. Soubor musí zůstat root:root 0600.",
    ]
    if primary_host:
        pam_lines.append(
            f"{primary_host}:{primary_port} {stored_secrets['primary']} {timeout}"
        )
    if secondary_host:
        pam_lines.append(
            f"{secondary_host}:{secondary_port} {stored_secrets['secondary']} {timeout}"
        )
    metadata.update(
        {
            "primary_host": primary_host,
            "primary_port": primary_port,
            "primary_secret_set": bool(stored_secrets["primary"]),
            "secondary_host": secondary_host,
            "secondary_port": secondary_port,
            "secondary_secret_set": bool(stored_secrets["secondary"]),
            "timeout": timeout,
            "retries": retries,
            "radius_last_check": (
                time.strftime("%Y-%m-%dT%H:%M:%S%z") if mode == "radius" else ""
            ),
            "radius_last_check_ok": mode == "radius",
        }
    )
    atomic_write(
        RADIUS_SECRETS,
        json.dumps(stored_secrets, indent=2) + "\n",
        0o600,
    )
    atomic_write(PAM_RADIUS_CONFIG, "\n".join(pam_lines) + "\n", 0o600)
    atomic_write(
        PAM_RADIUS_SERVICE,
        "# Dokumentační profil; SSH používá stejný modul přes /etc/pam.d/sshd.\n"
        "auth requisite pam_consolepi_user.so\n"
        "auth requisite pam_radius_auth.so "
        "conf=/etc/consolepi/pam_radius_auth.conf try_first_pass "
        f"retry={retries} client_id=ConsolePi\n"
        "auth required pam_consolepi_user.so restore\n"
        "account required pam_permit.so\n",
        0o644,
    )
    atomic_write(RADIUS_META, json.dumps(metadata, indent=2) + "\n", 0o644)
    apply_authentication_files(mode, retries)
    atomic_write(
        AUTH_CONFIG,
        "# Spravováno ConsolePi. Hodnoty: local_key, local_password, radius.\n"
        f"AUTH_MODE={mode}\n",
        0o644,
    )
    print(json.dumps({"mode": mode}))


def web_password_set():
    value = sys.stdin.read(1025).strip()
    if len(value) > 1024 or not value.startswith(("scrypt:", "pbkdf2:")):
        raise ValueError("Neplatný hash webového hesla.")
    atomic_write(WEB_AUTH, value + "\n", 0o640)
    os.chown(WEB_AUTH, 0, pwd.getpwnam("consolepi-web").pw_gid)
    print(json.dumps({"updated": True}))


def log_settings():
    defaults = {
        "TRANSCRIPT_ENABLED": "no",
        "TRANSCRIPT_MODE": "events",
        "TRANSCRIPT_DIR": "/var/log/consolepi/transcripts",
        "TRANSCRIPT_MAX_TOTAL_MB": "256",
        "TRANSCRIPT_MAX_SESSION_MB": "25",
        "TRANSCRIPT_MIN_FREE_MB": "512",
        "TRANSCRIPT_RETENTION_DAYS": "30",
        "BAUD": "9600",
    }
    if CONSOLE_CONFIG.exists():
        for line in CONSOLE_CONFIG.read_text().splitlines():
            key, separator, value = line.partition("=")
            if separator and key in defaults:
                defaults[key] = value.strip()
    return defaults


def write_log_settings(values):
    atomic_write(
        CONSOLE_CONFIG,
        "# Spravováno ConsolePi. Úplné přepisy mohou obsahovat citlivé údaje.\n"
        f"TRANSCRIPT_ENABLED={values['TRANSCRIPT_ENABLED']}\n"
        f"TRANSCRIPT_MODE={values['TRANSCRIPT_MODE']}\n"
        "TRANSCRIPT_DIR=/var/log/consolepi/transcripts\n"
        f"TRANSCRIPT_MAX_TOTAL_MB={values['TRANSCRIPT_MAX_TOTAL_MB']}\n"
        f"TRANSCRIPT_MAX_SESSION_MB={values['TRANSCRIPT_MAX_SESSION_MB']}\n"
        f"TRANSCRIPT_MIN_FREE_MB={values['TRANSCRIPT_MIN_FREE_MB']}\n"
        f"TRANSCRIPT_RETENTION_DAYS={values['TRANSCRIPT_RETENTION_DAYS']}\n"
        "BAUD=9600\n",
        0o644,
    )


def logs_status():
    result = run(str(LOG_MAINTAIN), "--status")
    print(result.stdout, end="")


def logs_configure():
    payload = json.loads(sys.stdin.read(4097))
    mode = str(payload.get("mode", "events"))
    if mode not in {"events", "output", "full"}:
        raise ValueError("Neplatný režim záznamu komunikace.")
    limits = {}
    ranges = {
        "max_total_mb": (32, 2048),
        "max_session_mb": (1, 256),
        "min_free_mb": (128, 4096),
        "retention_days": (1, 365),
    }
    for key, (minimum, maximum) in ranges.items():
        try:
            limits[key] = int(payload.get(key, 0))
        except (TypeError, ValueError):
            raise ValueError("Limity logování musí být celá čísla.")
        if not minimum <= limits[key] <= maximum:
            raise ValueError(
                f"Hodnota {key} musí být v rozsahu {minimum}–{maximum}."
            )
    if limits["max_session_mb"] > limits["max_total_mb"]:
        raise ValueError("Limit jedné relace nesmí překročit celkový limit.")
    values = log_settings()
    values.update(
        {
            "TRANSCRIPT_ENABLED": "no" if mode == "events" else "yes",
            "TRANSCRIPT_MODE": mode,
            "TRANSCRIPT_MAX_TOTAL_MB": str(limits["max_total_mb"]),
            "TRANSCRIPT_MAX_SESSION_MB": str(limits["max_session_mb"]),
            "TRANSCRIPT_MIN_FREE_MB": str(limits["min_free_mb"]),
            "TRANSCRIPT_RETENTION_DAYS": str(limits["retention_days"]),
        }
    )
    write_log_settings(values)
    run(str(LOG_MAINTAIN), "--once")
    print(json.dumps({"configured": True}))


def logs_clear():
    confirmation = sys.stdin.read(32).strip()
    if confirmation != "VYMAZAT":
        raise ValueError("Vymazání logů vyžaduje potvrzení textem VYMAZAT.")
    removed = 0
    transcripts = LOG_ROOT / "transcripts"
    if transcripts.exists():
        for path in transcripts.glob("*/*"):
            if path.is_file() and not path.name.endswith(".active"):
                path.unlink()
                removed += 1
    for path in LOG_ROOT.glob("ports*.log*"):
        if path.is_file():
            path.unlink()
            removed += 1
    run(
        "logger", "-p", "authpriv.notice", "-t", "consolepi",
        f"LOGS_CLEARED files={removed}",
    )
    print(json.dumps({"cleared": True, "files": removed}))


def safe_log_path(relative):
    if not re.fullmatch(
        r"(?:ports(?:-[0-9TZ]+)?\.log(?:\.[0-9]+)?(?:\.gz)?|"
        r"transcripts/220[1-4]/[A-Za-z0-9_.:-]+\.(?:log|log\.gz|active))",
        relative,
    ):
        raise ValueError("Neplatná cesta k logu.")
    candidate = (LOG_ROOT / relative).resolve()
    if LOG_ROOT.resolve() not in candidate.parents or not candidate.is_file():
        raise ValueError("Log nebyl nalezen.")
    return candidate


def logs_list():
    records = []
    for path in sorted(LOG_ROOT.glob("ports*.log*"), reverse=True):
        if path.is_file():
            records.append(
                {
                    "path": str(path.relative_to(LOG_ROOT)),
                    "type": "Události USB portů",
                    "port": "všechny",
                    "size": path.stat().st_size,
                    "modified": int(path.stat().st_mtime),
                    "active": False,
                }
            )
    transcripts = LOG_ROOT / "transcripts"
    if transcripts.exists():
        for path in sorted(transcripts.glob("220[1-4]/*"), reverse=True):
            if path.is_file() and path.name.endswith((".log", ".log.gz", ".active")):
                records.append(
                    {
                        "path": str(path.relative_to(LOG_ROOT)),
                        "type": "Sériový přepis",
                        "port": path.parent.name,
                        "size": path.stat().st_size,
                        "modified": int(path.stat().st_mtime),
                        "active": path.name.endswith(".active"),
                    }
                )
    print(json.dumps(records))


def logs_read():
    payload = json.loads(sys.stdin.read(1025))
    path = safe_log_path(str(payload.get("path", "")))
    limit = 256 * 1024
    if path.name.endswith(".gz"):
        with gzip.open(path, "rb") as handle:
            data = handle.read(limit + 1)
    else:
        with path.open("rb") as handle:
            if path.stat().st_size > limit:
                handle.seek(-limit, os.SEEK_END)
            data = handle.read(limit + 1)
    truncated = len(data) > limit or (
        not path.name.endswith(".gz") and path.stat().st_size > limit
    )
    data = data[-limit:]
    text = data.decode("utf-8", errors="replace")
    text = re.sub(r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07]*(?:\x07|\x1b\\))", "", text)
    text = "".join(
        character
        for character in text
        if character in "\n\r\t" or ord(character) >= 32
    )
    print(
        json.dumps(
            {
                "path": str(path.relative_to(LOG_ROOT)),
                "content": text,
                "truncated": truncated,
                "size": path.stat().st_size,
                "modified": int(path.stat().st_mtime),
            }
        )
    )


def updates_status():
    if UPDATE_STATE.exists():
        print(UPDATE_STATE.read_text(), end="")
        return
    print(
        json.dumps(
            {
                "status": "unknown",
                "checked_at": "",
                "updates": 0,
                "packages": [],
                "error": "",
                "reboot_required": Path("/var/run/reboot-required").exists(),
            }
        )
    )


def updates_action(action):
    if action == "check":
        unit = "consolepi-update-check.service"
    elif action == "upgrade":
        if sys.stdin.read(32).strip() != "AKTUALIZOVAT":
            raise ValueError(
                "Instalace aktualizací vyžaduje potvrzení textem AKTUALIZOVAT."
            )
        unit = "consolepi-system-upgrade.service"
    else:
        raise ValueError("Nepovolená operace aktualizací.")
    active = run("systemctl", "is-active", unit, check=False).stdout.strip()
    if active in {"active", "activating"}:
        raise ValueError("Požadovaná operace aktualizací již probíhá.")
    run("systemctl", "start", "--no-block", unit)
    run(
        "logger", "-p", "authpriv.notice", "-t", "consolepi",
        f"UPDATE_ACTION action={action}",
    )
    print(json.dumps({"started": action}))


def factory_reset():
    confirmation = sys.stdin.read(32).strip()
    if confirmation != "RESET":
        raise ValueError("Tovární reset vyžaduje potvrzení textem RESET.")

    locks = []
    try:
        for port in ("2201", "2202", "2203", "2204"):
            locks.append(ensure_console_free(port))

        stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
        backup = Path("/var/backups/consolepi") / f"factory-reset-{stamp}"
        backup.mkdir(parents=True, mode=0o700)
        for path in (
            PORTS_CONFIG,
            SERIAL_CONFIG,
            CONSOLE_CONFIG,
            AUTH_CONFIG,
            RADIUS_META,
            RADIUS_SECRETS,
            PAM_RADIUS_CONFIG,
            PAM_RADIUS_SERVICE,
            SSH_DROPIN,
            PAM_SSHD,
            NFTABLES,
            AUTHORIZED_KEYS,
            WEB_AUTH,
            UDEV_RULES,
            IDENTITY_CONFIG,
            DISCOVERY_CONFIG,
            ACCESS_SOURCES_CONFIG,
        ):
            if path.exists():
                target = backup / path.relative_to("/")
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(path, target)

        log_dir = Path("/var/log/consolepi")
        if log_dir.exists():
            shutil.copytree(log_dir, backup / "var/log/consolepi")

        ports = ["# SSH_PORT|DEVICE_NAME|SERIAL_DEVICE"]
        serial = [
            "# SSH_PORT|BAUD|DATABITS|PARITY|STOPBITS|FLOW|LOCAL_ECHO"
        ]
        for index, port in enumerate(("2201", "2202", "2203", "2204"), 1):
            ports.append(
                f"{port}|KONZOLE-{index}|/dev/consolepi/unassigned-{index}"
            )
            serial.append(f"{port}|9600|8|none|1|none|no")
        atomic_write(PORTS_CONFIG, "\n".join(ports) + "\n", 0o644)
        atomic_write(SERIAL_CONFIG, "\n".join(serial) + "\n", 0o644)
        atomic_write(
            CONSOLE_CONFIG,
            "# Výchozí nastavení ConsolePi po továrním resetu\n"
            "TRANSCRIPT_ENABLED=no\n"
            "TRANSCRIPT_MODE=events\n"
            "TRANSCRIPT_DIR=/var/log/consolepi/transcripts\n"
            "TRANSCRIPT_MAX_TOTAL_MB=256\n"
            "TRANSCRIPT_MAX_SESSION_MB=25\n"
            "TRANSCRIPT_MIN_FREE_MB=512\n"
            "TRANSCRIPT_RETENTION_DAYS=30\n"
            "BAUD=9600\n",
            0o644,
        )

        radius_meta = {
            "primary_host": "",
            "primary_port": 1812,
            "primary_secret_set": False,
            "secondary_host": "",
            "secondary_port": 1812,
            "secondary_secret_set": False,
            "timeout": 3,
            "retries": 1,
            "accounting": False,
        }
        atomic_write(RADIUS_META, json.dumps(radius_meta, indent=2) + "\n", 0o644)
        atomic_write(
            RADIUS_SECRETS,
            json.dumps({"primary": "", "secondary": ""}, indent=2) + "\n",
            0o600,
        )
        atomic_write(
            PAM_RADIUS_CONFIG,
            "# Spravováno ConsolePi. RADIUS není po továrním resetu nastaven.\n",
            0o600,
        )
        atomic_write(
            PAM_RADIUS_SERVICE,
            "# RADIUS není po továrním resetu nastaven.\n"
            "account required pam_permit.so\n",
            0o644,
        )
        atomic_write(
            PROXY_CONFIG,
            json.dumps(proxy_defaults(), indent=2) + "\n",
            0o600,
        )
        APT_PROXY_CONFIG.unlink(missing_ok=True)
        # Tovární reset nesmí ponechat organizací určený mirror.  Zdrojové
        # soubory jsou generované z této bezpečné výchozí konfigurace;
        # volání nevyžaduje dostupnou síť.
        apt_sources_reset()
        atomic_write(LABELS_CONFIG, "{}\n", 0o644)
        # Vlastní povolené zdroje jsou provozní nastavení firewallu. Tovární
        # reset je smaže; aktuální lokální ethernetová síť se doplní níže
        # automaticky podle právě získané DHCP adresy.
        write_access_sources([])
        atomic_write(DISCOVERY_CONFIG, json.dumps(discovery_defaults()) + "\n", 0o644)
        run("systemctl", "disable", "--now", "lldpd", check=False)
        atomic_write(SNMP_CONFIG, json.dumps(snmp_defaults(), indent=2) + "\n", 0o600)
        SNMP_SECRETS.unlink(missing_ok=True)
        run("systemctl", "disable", "--now", "snmpd", check=False)
        atomic_write(
            IDENTITY_CONFIG,
            json.dumps({
                "display_name": "ConsolePi",
                "location": "",
                "description": "Sériový konzolový server",
            }, indent=2) + "\n",
            0o644,
        )
        default_hostname = "consolepi"
        run("hostnamectl", "set-hostname", default_hostname)
        hosts_lines = HOSTS_CONFIG.read_text().splitlines()
        replacement = f"127.0.1.1\t{default_hostname}"
        for index, line in enumerate(hosts_lines):
            if line.split("#", 1)[0].split()[:1] == ["127.0.1.1"]:
                hosts_lines[index] = replacement
                break
        else:
            hosts_lines.append(replacement)
        atomic_write(HOSTS_CONFIG, "\n".join(hosts_lines) + "\n", 0o644)
        atomic_write(
            FIRSTBOOT_CONFIG,
            json.dumps({"state": "pending", "reason": "factory_reset"}, indent=2) + "\n",
            0o600,
        )

        default_auth = (
            "local_password"
            if console_password_set()
            else "local_key"
        )
        if default_auth == "local_key" and not read_key_lines():
            raise ValueError(
                "Reset nelze dokončit: není nastaveno heslo ani SSH klíč konzole."
            )
        apply_authentication_files(default_auth, 1)
        atomic_write(
            AUTH_CONFIG,
            "# Spravováno ConsolePi. Hodnoty: local_key, local_password, radius.\n"
            f"AUTH_MODE={default_auth}\n",
            0o644,
        )

        if UDEV_RULES.exists():
            UDEV_RULES.unlink()
            run("udevadm", "control", "--reload-rules", check=False)

        transcript_dir = log_dir / "transcripts"
        if transcript_dir.exists():
            shutil.rmtree(transcript_dir)
        for path in log_dir.glob("ports*.log*"):
            if path.is_file():
                path.unlink()
        console_user = pwd.getpwnam("console")
        transcript_dir.mkdir(parents=True, mode=0o700)
        os.chown(transcript_dir, console_user.pw_uid, console_user.pw_gid)

        run(
            "nmcli", "connection", "modify", CONNECTION,
            "ipv4.method", "auto", "ipv4.addresses", "",
            "ipv4.gateway", "", "ipv4.dns", "",
        )
        run("nmcli", "connection", "up", CONNECTION)
        address, network = active_network()
        update_firewall(network)
        run(
            "logger", "-p", "authpriv.notice", "-t", "consolepi",
            f"FACTORY_RESET backup={backup} address={address} network={network}",
        )
        print(
            json.dumps(
                {
                    "reset": True,
                    "address": address,
                    "network": network,
                    "auth_mode": default_auth,
                    "backup": str(backup),
                }
            )
        )
    finally:
        for lock in locks:
            lock.close()


def system_power_action(action):
    if action != "reboot":
        raise ValueError("Nepovolená systémová akce.")
    unit = f"consolepi-{action}-{int(time.time())}"
    run(
        "logger",
        "-p",
        "authpriv.notice",
        "-t",
        "consolepi",
        f"WEB_SYSTEM_ACTION action={action}",
    )
    run(
        "systemd-run",
        f"--unit={unit}",
        "--on-active=8s",
        "--collect",
        "/usr/bin/systemctl",
        action,
    )
    print(json.dumps({"action": action, "delay": 8}))


def main():
    if os.geteuid() != 0:
        raise PermissionError("Tento nástroj musí běžet jako root.")
    if len(sys.argv) >= 3 and sys.argv[1] == "network":
        action = sys.argv[2]
        if action == "apply":
            apply(sys.argv[3:])
        elif action == "activate" and len(sys.argv) == 4:
            activate(sys.argv[3])
        elif action == "confirm" and len(sys.argv) == 4:
            confirm(sys.argv[3])
        elif action == "rollback" and len(sys.argv) == 4:
            state = json.loads(STATE.read_text())
            if secrets.compare_digest(state["token"], sys.argv[3]):
                restore()
        elif action == "pending" and len(sys.argv) == 3:
            if not STATE.exists():
                raise ValueError("Žádná nepotvrzená síťová změna.")
            print(STATE.read_text())
        elif action == "pending-status" and len(sys.argv) == 3:
            print(json.dumps(pending_status()))
        elif action == "confirm-pending" and len(sys.argv) == 3:
            if not STATE.exists():
                raise ValueError("Žádná nepotvrzená síťová změna.")
            confirm(json.loads(STATE.read_text())["token"])
            print(json.dumps({"confirmed": True}))
        else:
            raise ValueError("Nepovolená síťová operace.")
    elif len(sys.argv) >= 3 and sys.argv[1] == "access":
        action = sys.argv[2]
        if action == "status" and len(sys.argv) == 3:
            access_status()
        elif action == "add" and len(sys.argv) == 6:
            access_add(sys.argv[3], sys.argv[4], sys.argv[5])
        elif action == "update" and len(sys.argv) == 7:
            access_update(sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6])
        elif action == "delete" and len(sys.argv) == 4:
            access_delete(sys.argv[3])
        elif action == "generic-bootstrap" and len(sys.argv) == 3:
            access_generic_bootstrap()
        elif action == "firstboot-finalize" and len(sys.argv) == 5:
            access_firstboot_finalize(sys.argv[3], sys.argv[4])
        elif action == "migrate" and len(sys.argv) == 3:
            access_migrate()
        else:
            raise ValueError("Nepovolená operace se zdroji přístupu.")
    elif len(sys.argv) == 3 and sys.argv[1] == "firewall":
        if sys.argv[2] == "drops":
            firewall_drops()
        else:
            raise ValueError("Nepovolená operace firewallu.")
    elif len(sys.argv) >= 3 and sys.argv[1] == "keys":
        action = sys.argv[2]
        if action == "list" and len(sys.argv) == 3:
            keys_list()
        elif action == "add" and len(sys.argv) == 4:
            keys_add(sys.argv[3])
        elif action == "delete" and len(sys.argv) == 4:
            keys_delete(sys.argv[3])
        else:
            raise ValueError("Nepovolená operace s klíči.")
    elif len(sys.argv) >= 3 and sys.argv[1] == "serial":
        action = sys.argv[2]
        if action == "list" and len(sys.argv) == 3:
            serial_list()
        elif action == "set" and len(sys.argv) == 10:
            serial_set(sys.argv[3:])
        elif action == "reset" and len(sys.argv) == 4:
            serial_reset(sys.argv[3])
        else:
            raise ValueError("Nepovolená operace se sériovým portem.")
    elif len(sys.argv) >= 3 and sys.argv[1] == "ports":
        action = sys.argv[2]
        if action == "discover" and len(sys.argv) == 3:
            ports_discover()
        elif action == "assign" and len(sys.argv) == 5:
            ports_assign(sys.argv[3], sys.argv[4])
        elif action == "unassign" and len(sys.argv) == 4:
            ports_unassign(sys.argv[3])
        else:
            raise ValueError("Nepovolená operace s přiřazením USB kabelu.")
    elif len(sys.argv) >= 3 and sys.argv[1] == "auth":
        action = sys.argv[2]
        if action == "status" and len(sys.argv) == 3:
            auth_status()
        elif action == "sync" and len(sys.argv) == 3:
            auth_sync()
        elif action == "configure" and len(sys.argv) == 3:
            auth_configure()
        else:
            raise ValueError("Nepovolená operace autentizace.")
    elif len(sys.argv) == 3 and sys.argv[1] == "discovery":
        if sys.argv[2] == "status":
            discovery_status()
        elif sys.argv[2] == "configure":
            discovery_configure()
        else:
            raise ValueError("Nepovolená operace síťové detekce.")
    elif len(sys.argv) == 3 and sys.argv[1] == "snmp":
        if sys.argv[2] == "status":
            snmp_status()
        elif sys.argv[2] == "configure":
            snmp_configure()
        else:
            raise ValueError("Nepovolená operace SNMPv3.")
    elif len(sys.argv) == 3 and sys.argv[1] == "system":
        system_power_action(sys.argv[2])
    elif len(sys.argv) == 3 and sys.argv[1] == "web-password":
        if sys.argv[2] != "set":
            raise ValueError("Nepovolená operace s webovým heslem.")
        web_password_set()
    elif len(sys.argv) == 3 and sys.argv[1] == "factory":
        if sys.argv[2] != "reset":
            raise ValueError("Nepovolená tovární operace.")
        factory_reset()
    elif len(sys.argv) >= 3 and sys.argv[1] == "logs":
        action = sys.argv[2]
        if action == "status" and len(sys.argv) == 3:
            logs_status()
        elif action == "configure" and len(sys.argv) == 3:
            logs_configure()
        elif action == "clear" and len(sys.argv) == 3:
            logs_clear()
        elif action == "list" and len(sys.argv) == 3:
            logs_list()
        elif action == "read" and len(sys.argv) == 3:
            logs_read()
        else:
            raise ValueError("Nepovolená operace s logy.")
    elif len(sys.argv) >= 3 and sys.argv[1] == "updates":
        action = sys.argv[2]
        if action == "status" and len(sys.argv) == 3:
            updates_status()
        elif action in {"check", "upgrade"} and len(sys.argv) == 3:
            updates_action(action)
        else:
            raise ValueError("Nepovolená operace aktualizací.")
    elif len(sys.argv) >= 3 and sys.argv[1] == "proxy":
        action = sys.argv[2]
        if action == "status" and len(sys.argv) == 3:
            proxy_status()
        elif action == "configure" and len(sys.argv) == 3:
            proxy_configure()
        else:
            raise ValueError("Nepovolená operace proxy.")
    elif len(sys.argv) == 3 and sys.argv[1] == "repositories":
        if sys.argv[2] == "status":
            apt_sources_status()
        elif sys.argv[2] == "configure":
            apt_sources_configure()
        elif sys.argv[2] == "reset":
            apt_sources_reset()
        else:
            raise ValueError("Nepovolená operace APT repozitářů.")
    elif len(sys.argv) == 4 and sys.argv[1] == "label":
        if sys.argv[2] != "set":
            raise ValueError("Nepovolená operace popisku.")
        label_set(sys.argv[3])
    else:
        raise ValueError("Nepovolená operace.")


try:
    main()
except Exception as exc:
    print(str(exc), file=sys.stderr)
    raise SystemExit(1)
